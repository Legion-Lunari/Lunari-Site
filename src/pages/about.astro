---

<BaseLayout
  title="Nosotras - Legion Lunari"
  description="Conoce al staff y el corazón detrás de Legion Lunari, la comunidad de LoL/LAN exclusiva para mujeres."
>
  <div class="summon-stage">
    <section class="social-network">
      <div class="ns-head" data-summon="1">
        <span class="ns-moon" aria-hidden="true">
          <i class="ns-moon__line"></i>
          <em>✦</em>
          <svg class="ns-moon__svg" viewBox="0 0 26 24">
            <defs>
              <mask id="ns-moon-cut">
                <rect width="26" height="24" fill="#fff"></rect>
                <circle cx="15" cy="9.5" r="7.6" fill="#000"></circle>
              </mask>
            </defs>
            <!-- creciente fina que abre hacia la estrellita -->
            <circle
              cx="11.5"
              cy="12"
              r="8"
              fill="#cbbcf2"
              mask="url(#ns-moon-cut)"></circle>
            <path
              d="M19.5 4 Q20 6.6 22.5 7 Q20 7.4 19.5 10 Q19 7.4 16.5 7 Q19 6.6 19.5 4Z"
              fill="#e9e2f8"></path>
          </svg>
          <em>✦</em>
          <i class="ns-moon__line ns-moon__line--end"></i>
        </span>
        <h3 class="ns-title">
          <span class="ns-title__line" aria-hidden="true"><i>+</i><b>✦</b></span
          >
          <span
            >¡Sigue nuestras redes <span class="ns-grad">sociales</span>!</span
          >
          <span class="ns-title__line ns-title__line--end" aria-hidden="true"
            ><b>✦</b><i>+</i></span
          >
        </h3>
      </div>

      <div class="social-network-links">
        {
          socials.map((social, i) => (
            <span class="summon-item" data-summon={String(2 + i)}>
              <Button href={social.href} style={social.style}>
                <span slot="left-icon" set:html={social.icon} />
                {social.name}
              </Button>
            </span>
          ))
        }
      </div>
    </section>

    <section class="staff">
      <div class="ns-head" data-summon="5">
        <h3 class="ns-title">
          <span class="ns-title__line" aria-hidden="true"><i>+</i><b>✦</b></span
          >
          <span>Nuestra adminis<span class="ns-grad">tración</span></span>
          <span class="ns-title__line ns-title__line--end" aria-hidden="true"
            ><b>✦</b><i>+</i></span
          >
        </h3>
      </div>

      <div class="admin-grid">
        {
          admins.map((admin, i) => (
            <div class="summon-card" data-summon={String(6 + i)}>
              <AdminCard
                name={admin.name}
                role={admin.role}
                image={admin.image}
                imagePosition={admin.imagePosition}
                playstyle={admin.playstyle}
                region={admin.region}
                lanes={admin.lanes}
                lastLabel={admin.lastLabel}
                lastValue={admin.lastValue}
                confession={admin.confession}
                accent={admin.accent}
              />
            </div>
          ))
        }
      </div>

      <div
        class="ns-head"
        style="margin-top: 2rem"
        data-summon={String(7 + admins.length)}
      >
        <h3 class="ns-title">
          <span class="ns-title__line" aria-hidden="true"><i>+</i><b>✦</b></span
          >
          <span>Nuestro <span class="ns-grad">staff</span></span>
          <span class="ns-title__line ns-title__line--end" aria-hidden="true"
            ><b>✦</b><i>+</i></span
          >
        </h3>
      </div>

      <div
        class="staff-grid summon-burst"
        data-summon={String(8 + admins.length)}
      >
        {
          staff.map((member) => (
            <div class="summon-card">
              <StaffCard
                name={member.name}
                role={member.role}
                accent={member.accent}
              />
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <StarSummon />
</BaseLayout>

<script>
  // Utilidad de consola para previsualizar la fila de staff con más cartas:
  //   lunariStaffDemo(5) → clona las cartas existentes hasta tener 5
  //   lunariStaffDemo(3) → restaura las originales
  const grid = document.querySelector<HTMLElement>(".admin-grid");
  (window as any).lunariStaffDemo = (n = 5) => {
    if (!grid) return "no hay grid";
    grid.querySelectorAll("[data-demo]").forEach((el) => el.remove());
    const bases = Array.from(
      grid.querySelectorAll<HTMLElement>(".summon-card"),
    );
    for (let i = 0; i < n - bases.length; i++) {
      const clone = bases[i % bases.length].cloneNode(true) as HTMLElement;
      clone.setAttribute("data-demo", "");
      clone.removeAttribute("data-summon");
      clone.classList.add("sm-lit"); // visible aunque la invocación esté armada
      grid.appendChild(clone);
    }
    return `${grid.children.length} cartas en la fila`;
  };
  console.info(
    "[Lunari] Vista previa del staff: lunariStaffDemo(5) · restaurar: lunariStaffDemo(3)",
  );
</script>

<style>
  section {
    padding-left: 5%;
    padding-right: 5%;
  }

  .social-network {
    padding-top: calc(var(--nav-h) + 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* Encabezados ornamentados: ☾ arriba y título flanqueado por ── ✦ */
  .ns-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  /* Ornamento lunar: ── · ✦ ☾✦ ✦ · ── */
  .ns-moon {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--lavender-200);
    font-size: 1rem;
    line-height: 1;
    text-shadow: 0 0 10px
      color-mix(in srgb, var(--lavender-400) 60%, transparent);
  }
  .ns-moon em {
    font-style: normal;
    font-size: 0.5rem;
  }
  .ns-moon__svg {
    width: 1.7rem;
    height: auto;
    max-width: none;
    filter: drop-shadow(0 0 7px rgba(185, 163, 240, 0.75));
  }
  .ns-moon__line {
    position: relative;
    width: clamp(2.5rem, 8vw, 6.5rem);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--lavender-200) 50%, transparent)
    );
  }
  .ns-moon__line--end {
    background: linear-gradient(
      to left,
      transparent,
      color-mix(in srgb, var(--lavender-200) 50%, transparent)
    );
  }
  /* Puntito de diamante sobre cada línea */
  .ns-moon__line::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 30%;
    width: 3px;
    height: 3px;
    transform: translate(-50%, -50%) rotate(45deg);
    background: color-mix(in srgb, var(--lavender-200) 75%, transparent);
  }
  .ns-moon__line--end::after {
    left: 70%;
  }
  .ns-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    margin: 0;
    font-size: var(--step-2);
    color: var(--moonlight);
    text-align: center;
  }
  .ns-grad {
    background: linear-gradient(
      120deg,
      var(--lavender-200),
      var(--lavender-400) 55%,
      var(--violet-600)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ns-title__line {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--lavender-200);
    font-size: 0.8rem;
    line-height: 1;
    text-shadow: 0 0 8px
      color-mix(in srgb, var(--lavender-400) 55%, transparent);
  }
  .ns-title__line b {
    font-weight: 400;
  }
  /* Crucecita satélite, más tenue y elevada */
  .ns-title__line i {
    font-style: normal;
    font-size: 0.7em;
    opacity: 0.65;
    transform: translateY(-0.5em);
  }
  .ns-title__line::before,
  .ns-title__line::after {
    content: "";
    height: 1px;
  }
  .ns-title__line::before {
    width: clamp(1.5rem, 6vw, 5rem);
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--lavender-200) 55%, transparent)
    );
  }
  .ns-title__line::after {
    width: 1.3rem;
    background: color-mix(in srgb, var(--lavender-200) 40%, transparent);
  }
  .ns-title__line--end::before {
    width: 1.3rem;
    background: color-mix(in srgb, var(--lavender-200) 40%, transparent);
  }
  .ns-title__line--end::after {
    width: clamp(1.5rem, 6vw, 5rem);
    background: linear-gradient(
      to left,
      transparent,
      color-mix(in srgb, var(--lavender-200) 55%, transparent)
    );
  }
  @media (max-width: 680px) {
    .ns-title__line {
      display: none;
    }
  }

  .social-network-links {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    font-family: var(--font-body);
  }

  @media (max-width: 640px) {
    .social-network-links {
      flex-direction: column;
      align-items: center;
    }
  }

  .staff {
    padding-top: 3.5rem;
  }

  .admin-grid {
    display: grid;
    /* Caben hasta 5 cartas por fila (4 gaps de 1.5rem); con menos, auto-fit
