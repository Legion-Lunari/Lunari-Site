---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { transmission } from "../lib/2409/content";
import { getPublicRestorationState } from "../lib/2409/restoration";

export const prerender = false;

const state = await getPublicRestorationState(env);
const fragments = transmission.map((fragment) => ({
  ...fragment,
  ...state.find((item) => item.id === fragment.id)!,
}));
const restoredCount = fragments.filter((fragment) => fragment.unlocked).length;
---

<BaseLayout
  title="Canal 2409 — Legion Lunari"
  description="Una transmisión Lunari recuperada de un canal olvidado."
>
  <section class:list={["channel", { "is-complete": restoredCount === 3 }]}>
    <div class="channel__halo" aria-hidden="true"></div>
    <div class="channel__orbits" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <div class="wrap channel__wrap">
      <header class="channel__header">
        <p class="eyebrow" data-phase="◒">Canal recuperado · 2409</p>
        <h1>Transmisión <span>lunari</span></h1>
        <p class="channel__signal"><i aria-hidden="true"></i> Señal intermitente</p>
      </header>

      <div class="channel__grid">
        <section class="transmission" aria-labelledby="transmission-title">
          <div class="transmission__head">
            <h2 id="transmission-title">Registro de transmisión</h2>
            <span>{restoredCount}/3 fragmentos</span>
          </div>

          <div class="transmission__body">
            {
              fragments.map((fragment) => (
                <article
                  class:list={["fragment", { "is-restored": fragment.unlocked }]}
                  data-fragment={fragment.id}
                >
                  <div class="fragment__meta">
                    <span>F-{String(fragment.id).padStart(2, "0")}</span>
                    <span>{fragment.unlocked ? "señal estable" : "datos corruptos"}</span>
                  </div>
                  <pre>{fragment.unlocked ? fragment.decrypted : fragment.encrypted}</pre>
                  {fragment.unlocked && <span class="fragment__seal" aria-label="Fragmento restaurado">✦</span>}
                </article>
              ))
            }
          </div>
        </section>

        <aside class="restoration" aria-labelledby="restoration-title">
          <div class="restoration__head">
            <p class="eyebrow">Sistema de enlace</p>
            <h2 id="restoration-title">Código de restauración</h2>
          </div>
          <p class="restoration__intro">Introduce una clave para reconstruir cada tramo de la señal.</p>

          <div class="slots">
            {
              fragments.map((fragment) => (
                <form class="slot" data-restore-form data-fragment={fragment.id}>
                  <div class="slot__number" aria-hidden="true">{String(fragment.id).padStart(2, "0")}</div>
                  {
                    fragment.unlocked ? (
                      <div class="slot__restored">
                        <span class="slot__code">{fragment.code}</span>
                        <span>Restaurado</span>
                      </div>
                    ) : (
                      <>
                        <label class="sr-only" for={`restoration-code-${fragment.id}`}>Código para el fragmento {fragment.id}</label>
                        <input id={`restoration-code-${fragment.id}`} name="code" type="text" autocomplete="off" spellcheck="false" placeholder="introducir código" required />
                        <button type="submit">Validar</button>
                      </>
                    )
                  }
                </form>
              ))
            }
          </div>

          <p class="restoration__progress">Restauración: <strong>{restoredCount} / 3</strong></p>
          <p class="restoration__status" data-restore-status role="status" aria-live="polite"></p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>("[data-restore-status]");
  const forms = document.querySelectorAll<HTMLFormElement>("[data-restore-form]");

  forms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = form.elements.namedItem("code");
      if (!(input instanceof HTMLInputElement)) return;
      const button = form.querySelector<HTMLButtonElement>("button");
      const originalLabel = button?.textContent;
      if (button) {
        button.disabled = true;
        button.textContent = "...";
      }
      if (status) status.textContent = "Validando señal…";

      try {
        const response = await fetch("/api/2409/restore", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ fragment: Number(form.dataset.fragment), code: input.value }),
        });
        if (!response.ok) throw new Error("incompatible");
        if (status) status.textContent = "Fragmento restaurado. Reconstruyendo canal…";
        form.closest<HTMLElement>(".channel")?.classList.add("is-reconstructing");
        window.setTimeout(() => window.location.reload(), 420);
      } catch {
        if (status) status.textContent = "Código incompatible";
        form.classList.remove("is-error");
        void form.offsetWidth;
        form.classList.add("is-error");
        if (button) {
          button.disabled = false;
          button.textContent = originalLabel || "Validar";
        }
      }
    });
  });
</script>

<style>
  .channel { position: relative; isolation: isolate; min-height: 100svh; padding: calc(var(--nav-h) + clamp(3rem, 6vw, 5.5rem)) 0 var(--space-section); overflow: hidden; }
  .channel__halo { position:absolute; z-index:-1; width:min(70vw,62rem); aspect-ratio:1; top:-23rem; left:50%; transform:translateX(-50%); border-radius:50%; background:radial-gradient(circle, color-mix(in srgb,var(--celeste-400) 16%,transparent), color-mix(in srgb,var(--violet-600) 9%,transparent) 38%,transparent 68%); }
  .channel__orbits { position:absolute; z-index:-1; inset:0; pointer-events:none; opacity:.45; }
  .channel__orbits span { position:absolute; border:1px solid color-mix(in srgb,var(--lavender-400) 19%,transparent); border-radius:50%; }
  .channel__orbits span:nth-child(1) { width:55rem;height:20rem;top:8rem;right:-22rem;transform:rotate(-25deg); } .channel__orbits span:nth-child(2) { width:38rem;height:12rem;bottom:8rem;left:-17rem;transform:rotate(24deg); } .channel__orbits span:nth-child(3) { width:8px;height:8px;top:24%;left:16%;background:var(--celeste-400);box-shadow:0 0 20px 7px color-mix(in srgb,var(--celeste-400) 36%,transparent); }
  .channel__header { text-align:center; margin:0 auto clamp(2rem,5vw,4rem); }.channel__header h1 { font-size:var(--step-4); margin:.3rem 0; }.channel__header h1 span { font-family:var(--font-brand); font-weight:400; color:var(--lavender-200); }.channel__signal { display:inline-flex; align-items:center; gap:.55em; font-family:ui-monospace,SFMono-Regular,monospace; text-transform:uppercase; letter-spacing:.14em; font-size:.65rem; color:var(--text-muted); }.channel__signal i { width:.5em;height:.5em;background:var(--celeste-400); border-radius:50%; box-shadow:0 0 12px var(--celeste-400); animation:signal 1.8s ease-in-out infinite; }
  .channel__grid { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(17rem,.75fr); gap:clamp(1.2rem,3vw,2.5rem); align-items:start; }.transmission,.restoration { background:linear-gradient(145deg,color-mix(in srgb,var(--night-800) 77%,var(--ink)),color-mix(in srgb,var(--ink) 88%,var(--grape-800))); border:1px solid var(--border); box-shadow:var(--shadow-card),inset 0 1px 0 color-mix(in srgb,var(--moonlight) 8%,transparent); }.transmission { position:relative; overflow:hidden; }.transmission::before { content:""; position:absolute;inset:0;pointer-events:none; opacity:.25; background:repeating-linear-gradient(0deg,transparent 0 4px,rgba(238,240,255,.025) 5px); }.transmission__head { display:flex; justify-content:space-between; gap:1rem; align-items:baseline; padding:1.1rem 1.25rem; border-bottom:1px solid var(--border-soft); }.transmission h2,.restoration h2 { font-family:ui-monospace,SFMono-Regular,monospace; font-size:.85rem; letter-spacing:.12em; text-transform:uppercase; font-weight:600; }.transmission__head span { font: .65rem ui-monospace,SFMono-Regular,monospace; color:var(--text-faint); }.transmission__body { padding:.8rem; }.fragment { position:relative; padding:1.1rem 1.15rem 1.25rem; border:1px solid color-mix(in srgb,var(--lavender-400) 11%,transparent); background:color-mix(in srgb,var(--ink) 38%,transparent); overflow:hidden; }.fragment + .fragment { margin-top:.75rem; }.fragment__meta { display:flex; justify-content:space-between; gap:1rem; margin-bottom:.85rem; font: .61rem ui-monospace,SFMono-Regular,monospace; color:var(--text-faint); letter-spacing:.12em; text-transform:uppercase; }.fragment pre { margin:0; white-space:pre-wrap; font:clamp(.72rem,.6rem + .25vw,.86rem)/1.8 ui-monospace,SFMono-Regular,monospace; color:color-mix(in srgb,var(--lavender-200) 83%,var(--moonlight)); letter-spacing:.055em; }.fragment:not(.is-restored) pre { text-shadow:1px 0 color-mix(in srgb,var(--celeste-400) 38%,transparent),-1px 0 color-mix(in srgb,#ee8ebf 24%,transparent); }.fragment.is-restored { border-color:color-mix(in srgb,var(--celeste-400) 34%,transparent); background:linear-gradient(110deg,color-mix(in srgb,var(--celeste-400) 8%,transparent),transparent 50%); }.fragment.is-restored pre { font-family:var(--font-display); font-size:var(--step-0); letter-spacing:.01em; color:var(--moonlight); }.fragment__seal { position:absolute;right:1rem;bottom:.7rem;color:var(--celeste-400);text-shadow:0 0 14px var(--celeste-400); }
  .restoration { position:sticky; top:calc(var(--nav-h) + 1rem); padding:1.25rem; }.restoration__head .eyebrow { font-size:.57rem; }.restoration__head h2 { margin-top:.5rem; }.restoration__intro { margin:1rem 0 1.3rem; color:var(--text-muted); font-size:var(--step--1); line-height:1.55; }.slots { display:grid; gap:.7rem; }.slot { display:grid; grid-template-columns:1.8rem minmax(0,1fr) auto; gap:.55rem; align-items:center; min-height:2.65rem; }.slot__number { font: .7rem ui-monospace,SFMono-Regular,monospace; color:var(--celeste-400); }.slot input { min-width:0; width:100%; height:2.5rem; border:1px solid var(--border); background:color-mix(in srgb,var(--ink) 70%,transparent); color:var(--moonlight); padding:0 .7rem; font: .75rem ui-monospace,SFMono-Regular,monospace; }.slot input::placeholder { color:var(--text-faint); }.slot button { height:2.5rem; border:1px solid color-mix(in srgb,var(--celeste-400) 45%,transparent); background:color-mix(in srgb,var(--celeste-400) 11%,transparent); color:var(--moonlight); padding:0 .72rem; cursor:pointer; text-transform:uppercase; letter-spacing:.09em; font:600 .62rem var(--font-body); transition:.2s var(--ease-out); }.slot button:hover:not(:disabled) { background:color-mix(in srgb,var(--celeste-400) 23%,transparent); box-shadow:0 0 18px color-mix(in srgb,var(--celeste-400) 25%,transparent); }.slot button:disabled { opacity:.7;cursor:wait; }.slot__restored { grid-column:2/-1; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid color-mix(in srgb,var(--celeste-400) 28%,transparent); padding:.45rem 0; gap:.7rem; color:var(--celeste-400); font: .62rem ui-monospace,SFMono-Regular,monospace; text-transform:uppercase; letter-spacing:.08em; }.slot__code { color:var(--moonlight); overflow-wrap:anywhere; text-transform:none; }.restoration__progress { margin-top:1.3rem; padding-top:.9rem; border-top:1px solid var(--border-soft); color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; font-size:.64rem; }.restoration__progress strong { color:var(--celeste-400); }.restoration__status { min-height:1.5em; margin-top:.6rem; color:var(--celeste-400); font-size:var(--step--1); }.slot.is-error input { border-color:#e59ac1; animation:error .35s linear; }.channel.is-reconstructing .fragment { animation:reconstruct .42s ease-out both; }.channel.is-complete .transmission { box-shadow:var(--shadow-card),0 0 70px -25px color-mix(in srgb,var(--celeste-400) 42%,transparent); }
  @keyframes signal { 50% { opacity:.22; transform:scale(.65); } } @keyframes error { 25% { transform:translateX(-5px); } 75% { transform:translateX(5px); } } @keyframes reconstruct { 0% { filter:brightness(1.8) contrast(1.3); transform:translateX(-2px); } 100% { filter:none; transform:none; } }
  @media (max-width:800px) { .channel__grid { grid-template-columns:1fr; }.restoration { position:relative; top:auto; }.channel__header { text-align:left; }.channel__orbits span:nth-child(1) { right:-32rem; } }
  @media (max-width:430px) { .slot { grid-template-columns:1.55rem 1fr; }.slot button { grid-column:2; }.slot__restored { grid-column:2; align-items:flex-start; flex-direction:column; }.transmission__head { padding-inline:1rem; }.fragment { padding-inline:.85rem; } }
  @media (prefers-reduced-motion:reduce) { .channel__signal i,.slot.is-error input,.channel.is-reconstructing .fragment { animation:none; } }
</style>
