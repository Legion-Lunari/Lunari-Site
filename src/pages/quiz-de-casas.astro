---
import BaseLayout from '../layouts/BaseLayout.astro';
import TargonClimb from '../components/TargonClimb.astro';
import HouseReveal from '../components/HouseReveal.astro';
import { houses, questions } from '../data/houses';
import { ascentPoses } from '../data/ascent';
import { revealPoses, peakPose } from '../data/reveal';

const DISCORD_URL = 'https://discord.com/invite/j2mEbRg9jc';

// logo por casa (en /public/logos)
const logos: Record<string, string> = {
  febe: '/logos/Febe.svg', rea: '/logos/Rea.svg', dione: '/logos/Dione.svg', jano: '/logos/Jano.svg',
};

// Datos que el script del cliente necesita
const quizData = { houses, questions, ascentPoses, revealPoses, peakPose, logos };
---

<BaseLayout
  title="Quiz de Casas - Legion Lunari"
  description="Descubre a qué casa de la Legion Lunari perteneces. Un ritual lunar de 6 preguntas para invocadoras."
  hideFooter
>
  <TargonClimb />
  <HouseReveal />
  <!-- Bruma en movimiento (Vanta FOG) sólo para el intro -->
  <div class="quiz-fog" id="quiz-fog" aria-hidden="true"></div>

  <section class="quiz section" aria-live="polite">
    <div class="wrap quiz__wrap">

      <!-- Intro -->
      <div class="quiz-panel quiz-intro is-active" data-panel="intro">
        <p class="eyebrow">El ascenso a Targon</p>
        <h1 class="display quiz-intro__title">Descubre tu casa</h1>
        <p class="lede quiz-intro__lede">
          Cuatro casas nacieron en las laderas del Monte Targon: las Valientes,
          las Amables, las Inteligentes y las Creativas. Asciende paso a paso
          y la montaña revelará a cuál perteneces.
        </p>
        <p class="quiz-intro__meta">13 preguntas · unos 3 minutos</p>
        <button class="btn quiz-start" type="button">
          Comenzar el ascenso <span aria-hidden="true">✦</span>
        </button>
      </div>

      <!-- Preguntas -->
      <div class="quiz-panel quiz-questions" data-panel="questions" hidden>
        <div class="quiz-progress">
          <div class="quiz-progress__bar"><span class="quiz-progress__fill"></span></div>
          <p class="quiz-progress__label">
            <span class="q-current">1</span> / {questions.length}
          </p>
        </div>

        <div class="quiz-question" data-anim>
          <h2 class="quiz-question__text">&nbsp;</h2>
          <div class="quiz-options" role="group"></div>
        </div>

        <button class="quiz-back" type="button" hidden>← Anterior</button>
      </div>

    </div>
  </section>

  <!-- Revelado de la casa (scroll) -->
  <section class="reveal" id="reveal" hidden aria-live="polite">
    <div class="reveal__pin">
      <div class="reveal__stages">
        <div class="reveal__cap" data-rslot="name" data-cap>
          <p class="reveal__kicker">La luna te ha revelado tu casa…</p>
          <h2 class="reveal__name display">&nbsp;</h2>
          <p class="reveal__epiteto"></p>
        </div>
        <div class="reveal__cap" data-rslot="lema" data-cap>
          <p class="reveal__lema"></p>
        </div>
        <div class="reveal__cap" data-rslot="desc0" data-cap>
          <p class="reveal__desc"></p>
        </div>
        <div class="reveal__cap" data-rslot="desc1" data-cap>
          <p class="reveal__desc"></p>
        </div>
        <div class="reveal__cap" data-rslot="desc2" data-cap>
          <p class="reveal__desc"></p>
        </div>
        <div class="reveal__cap reveal__cap--final" data-rslot="final" data-cap>
          <ul class="reveal__rasgos"></ul>
          <div class="reveal__actions">
            <a href={DISCORD_URL} class="btn" target="_blank" rel="noopener">
              Unirme a mi casa en Discord <span aria-hidden="true">→</span>
            </a>
            <button class="btn btn--ghost quiz-retry" type="button">Repetir el ritual</button>
          </div>
        </div>
      </div>
      <span class="reveal__hint" aria-hidden="true"><span></span></span>
    </div>
  </section>

  <!-- Panel de ajuste (dev, ?tune=1) -->
  <aside class="tune" id="tune-panel" hidden aria-label="Ajuste del ascenso">
    <div class="tune__head">
      <button class="tune__nav" data-tune="prev" type="button" aria-label="Paso anterior">◀</button>
      <span class="tune__step">Paso <b data-tune="step">1</b> / <span data-tune="total">13</span></span>
      <button class="tune__nav" data-tune="next" type="button" aria-label="Paso siguiente">▶</button>
    </div>

    <div class="tune__rows">
      <label class="tune__row"><span>Zoom (camZ)</span><input type="range" data-field="camZ" min="2.4" max="8" step="0.05"><output data-out="camZ"></output></label>
      <label class="tune__row"><span>Altura (camY)</span><input type="range" data-field="camY" min="-3.5" max="3.5" step="0.05"><output data-out="camY"></output></label>
      <label class="tune__row"><span>Mira (lookY)</span><input type="range" data-field="lookY" min="-3.5" max="3.5" step="0.05"><output data-out="lookY"></output></label>
      <label class="tune__row"><span>Rotación (°)</span><input type="range" data-field="rotDeg" min="0" max="360" step="1"><output data-out="rotDeg"></output></label>
      <label class="tune__row"><span>FOV</span><input type="range" data-field="fov" min="12" max="60" step="1"><output data-out="fov"></output></label>
      <div class="tune__row tune__row--side">
        <span>Texto</span>
        <div class="tune__side">
          <button data-side="left" type="button">Izquierda</button>
          <button data-side="right" type="button">Derecha</button>
        </div>
      </div>
      <label class="tune__row"><span>Texto X</span><input type="range" data-field="tx" min="-500" max="500" step="5"><output data-out="tx"></output></label>
      <label class="tune__row"><span>Texto Y</span><input type="range" data-field="ty" min="-320" max="320" step="5"><output data-out="ty"></output></label>
    </div>

    <div class="tune__actions">
      <button class="btn tune__copy" data-tune="copy" type="button">Copiar configuración</button>
      <button class="tune__reset" data-tune="reset" type="button">Restablecer paso</button>
    </div>
    <p class="tune__hint">Ajusta y navega los pasos; al terminar, «Copiar configuración» y pégalo en <code>src/data/ascent.ts</code>.</p>
  </aside>

  <!-- Datos para el motor del quiz -->
  <script type="application/json" id="quiz-data" set:html={JSON.stringify(quizData)}></script>
</BaseLayout>

<script>
  // @ts-ignore: vanta no trae tipos
  import FOG from 'vanta/dist/vanta.fog.min';
  import * as THREE from 'three';

  type House = {
    id: string; nombre: string; epiteto: string; lema: string;
    descripcion: string[]; rasgos: string[]; color: string; simbolo: string;
  };
  type Option = { texto: string; puntos: Record<string, number> };
  type Question = { pregunta: string; opciones: Option[] };
  type Pose = {
    camY: number; camZ: number; lookY: number; rotDeg: number; fov: number;
    side: 'left' | 'right'; tx: number; ty: number;
  };

  type RPose = Pose & { slot: string };
  const raw = document.getElementById('quiz-data')?.textContent || '{}';
  const data = JSON.parse(raw) as {
    houses: House[]; questions: Question[]; ascentPoses: Pose[];
    revealPoses: RPose[]; logos: Record<string, string>;
  };
  const { houses, questions, logos } = data;
  const poses: Pose[] = data.ascentPoses || [];
  const revealPoses: RPose[] = data.revealPoses || [];
  const tuneParam = new URLSearchParams(location.search).get('tune');
  const tuneAscent = tuneParam === '1';
  const tuneReveal = tuneParam === 'reveal';
  const tuneMode = tuneParam !== null;

  // Control del ascenso 3D (TargonClimb)
  const TOTAL_STEPS = Math.max(1, questions.length - 1);
  const emitClimb = (s: number) =>
    window.dispatchEvent(new CustomEvent('targon:climb', { detail: { step: s, total: TOTAL_STEPS } }));
  const emitReset = () => window.dispatchEvent(new CustomEvent('targon:reset'));

  // Posición del texto de la pregunta según la pose del paso.
  function applyText(s: number) {
    const p = poses[s] || ({ side: 'left', tx: 0, ty: 0 } as Pose);
    // tx/ty afinados a 1600px; se escalan por el ancho para seguir al modelo.
    const k = window.innerWidth / 1600;
    els.qBlock.classList.toggle('is-left', p.side !== 'right');
    els.qBlock.classList.toggle('is-right', p.side === 'right');
    els.qBlock.style.setProperty('--tx', (p.tx || 0) * k + 'px');
    els.qBlock.style.setProperty('--ty', (p.ty || 0) * k + 'px');
  }
  // Control directo del modelo (tuning): fija la pose del paso.
  function emitPose(s: number) {
    const p = poses[s];
    if (!p) return;
    window.dispatchEvent(new CustomEvent('targon:pose', {
      detail: { camY: p.camY, camZ: p.camZ, lookY: p.lookY, rotDeg: p.rotDeg, fov: p.fov },
    }));
  }
  function emitSummit(cssColor: string) {
    const t = document.createElement('span');
    t.style.cssText = 'color:' + cssColor + ';position:absolute;visibility:hidden';
    document.body.appendChild(t);
    const rgb = getComputedStyle(t).color;
    t.remove();
    window.dispatchEvent(new CustomEvent('targon:summit', { detail: { color: rgb } }));
  }

  const panels = {
    intro: document.querySelector<HTMLElement>('[data-panel="intro"]')!,
    questions: document.querySelector<HTMLElement>('[data-panel="questions"]')!,
  };

  const els = {
    fill: document.querySelector<HTMLElement>('.quiz-progress__fill')!,
    current: document.querySelector<HTMLElement>('.q-current')!,
    qText: document.querySelector<HTMLElement>('.quiz-question__text')!,
    options: document.querySelector<HTMLElement>('.quiz-options')!,
    qBlock: document.querySelector<HTMLElement>('.quiz-question')!,
    back: document.querySelector<HTMLButtonElement>('.quiz-back')!,
  };

  let step = 0;
  const answers: number[] = [];

  function show(name: keyof typeof panels) {
    for (const [key, el] of Object.entries(panels)) {
      const active = key === name;
      el.hidden = !active;
      el.classList.toggle('is-active', active);
    }
    // Llevar el foco al inicio del panel para lectores de pantalla / teclado
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderQuestion() {
    const q = questions[step];
    els.current.textContent = String(step + 1);
    els.fill.style.transform = `scaleX(${step / questions.length})`;
    els.qText.textContent = q.pregunta;
    els.back.hidden = step === 0;
    applyText(step); // lado y desplazamiento del texto según la pose del paso
    if (tuneAscent) emitPose(step); // control directo en el panel
    else emitClimb(step); // gira y sube un paso en el monte

    els.options.innerHTML = '';
    q.opciones.forEach((opt, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'quiz-option';
      if (answers[step] === i) b.classList.add('is-chosen');
      b.innerHTML = `<span class="quiz-option__mark" aria-hidden="true">✦</span><span>${opt.texto}</span>`;
      b.addEventListener('click', () => choose(i));
      els.options.appendChild(b);
    });

    // reinicia animación de entrada
    els.qBlock.classList.remove('anim-in');
    void els.qBlock.offsetWidth;
    els.qBlock.classList.add('anim-in');
  }

  function choose(i: number) {
    if (tuneMode) return; // en modo ajuste no se avanza al responder
    answers[step] = i;
    const buttons = els.options.querySelectorAll('.quiz-option');
    buttons.forEach((b, idx) => b.classList.toggle('is-chosen', idx === i));
    // pequeña pausa para que se vea la selección, luego avanza
    window.setTimeout(() => {
      if (step < questions.length - 1) {
        step++;
        renderQuestion();
      } else {
        finish();
      }
    }, 320);
  }

  function finish() {
    els.fill.style.transform = 'scaleX(1)';
    const scores: Record<string, number> = {};
    houses.forEach((h) => (scores[h.id] = 0));
    answers.forEach((choiceIdx, qi) => {
      const pts = questions[qi].opciones[choiceIdx]?.puntos || {};
      for (const [id, val] of Object.entries(pts)) scores[id] = (scores[id] || 0) + (val as number);
    });
    let winner = houses[0];
    let best = -Infinity;
    for (const h of houses) {
      if (scores[h.id] > best) { best = scores[h.id]; winner = h; }
    }
    showReveal(winner);
  }

  // Resuelve una variable CSS de color a rgb() real (para Three.js).
  function resolveColor(css: string) {
    const t = document.createElement('span');
    t.style.cssText = 'color:' + css + ';position:absolute;visibility:hidden';
    document.body.appendChild(t);
    const rgb = getComputedStyle(t).color;
    t.remove();
    return rgb;
  }

  // Revelado de la casa (scroll)
  const revealSection = document.getElementById('reveal')!;
  const revealCaps = Array.from(revealSection.querySelectorAll<HTMLElement>('[data-cap]'));
  const quizSection = document.querySelector<HTMLElement>('.quiz')!;
  const climbEl = document.querySelector<HTMLElement>('.climb');
  let revealActive = false;

  function fillReveal(h: House) {
    revealSection.style.setProperty('--house-color', h.color);
    revealSection.querySelector<HTMLElement>('.reveal__name')!.textContent = h.nombre;
    revealSection.querySelector<HTMLElement>('.reveal__epiteto')!.textContent = h.epiteto;
    revealSection.querySelector<HTMLElement>('.reveal__lema')!.textContent = `“${h.lema}”`;
    const descs = revealSection.querySelectorAll<HTMLElement>('.reveal__desc');
    h.descripcion.forEach((par, i) => { if (descs[i]) descs[i].textContent = par; });
    const ul = revealSection.querySelector<HTMLElement>('.reveal__rasgos')!;
    ul.innerHTML = '';
    h.rasgos.forEach((t) => { const li = document.createElement('li'); li.textContent = t; ul.appendChild(li); });
  }

  // Los tx/ty de las poses se afinaron a 1600px de ancho; se escalan por la
  // proporción del viewport para que el texto siga al modelo en cualquier
  // resolución (el modelo y los left% también escalan con el ancho).
  const REVEAL_BASE_W = 1600;
  function positionRevealCap(cap: HTMLElement, i: number) {
    const pose = revealPoses[i];
    if (!pose) return;
    const k = window.innerWidth / REVEAL_BASE_W;
    cap.classList.toggle('is-left', pose.side !== 'right');
    cap.classList.toggle('is-right', pose.side === 'right');
    cap.style.setProperty('--tx', (pose.tx || 0) * k + 'px');
    cap.style.setProperty('--ty', (pose.ty || 0) * k + 'px');
  }
  window.addEventListener('resize', () => {
    if (revealActive) revealCaps.forEach((cap, i) => positionRevealCap(cap, i));
  }, { passive: true });
  function updateRevealCaps(p: number) {
    const N = revealPoses.length;
    const seg = 1 / (N - 1);
    revealCaps.forEach((cap, i) => {
      const center = i / (N - 1);
      let vis = 1 - Math.min(1, Math.abs(p - center) / (seg * 0.62));
      vis = Math.max(0, vis);
      // El paso final llega a full antes del tope y se queda fijo (sin arrastre).
      if (i === N - 1 && p >= center - seg) vis = Math.min(1, (p - (center - seg)) / (seg * 0.5));
      cap.style.opacity = String(vis);
      cap.style.pointerEvents = vis > 0.6 ? 'auto' : 'none';
    });
  }
  let rrTick = false;
  function updateRevealScroll() {
    if (!revealActive) return;
    const range = revealSection.offsetHeight - window.innerHeight;
    const p = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
    window.dispatchEvent(new CustomEvent('reveal:progress', { detail: { p } }));
    updateRevealCaps(p);
  }
  window.addEventListener('scroll', () => {
    if (revealActive && !rrTick) { rrTick = true; requestAnimationFrame(() => { rrTick = false; updateRevealScroll(); }); }
  }, { passive: true });

  function showReveal(h: House) {
    fillReveal(h);
    revealCaps.forEach((cap, i) => positionRevealCap(cap, i));
    quizSection.hidden = true;
    climbEl?.classList.add('is-off');
    fogEl?.classList.add('is-hidden');
    revealSection.hidden = false;
    window.dispatchEvent(new CustomEvent('reveal:init'));
    window.dispatchEvent(new CustomEvent('reveal:active', { detail: { on: true } }));
    window.dispatchEvent(new CustomEvent('reveal:house', { detail: { color: resolveColor(h.color), logo: logos[h.id] } }));
    revealActive = true;
    window.scrollTo({ top: 0 });
    updateRevealScroll();
  }
  function hideReveal() {
    revealActive = false;
    revealSection.hidden = true;
    climbEl?.classList.remove('is-off');
    window.dispatchEvent(new CustomEvent('reveal:active', { detail: { on: false } }));
    quizSection.hidden = false;
  }

  // Eventos
  // Bruma en movimiento (Vanta FOG) para el intro, con opacidad reducida (CSS).
  const fogEl = document.getElementById('quiz-fog');
  let vantaFog: any = null;
  if (fogEl && !tuneMode) {
    try {
      vantaFog = (FOG as any)({
        el: fogEl,
        THREE,
        mouseControls: true,
        touchControls: true,
        gyroControls: false,
        minHeight: 200.0,
        minWidth: 200.0,
        highlightColor: 0xdbd1da,
        midtoneColor: 0x9a4d9a,
        lowlightColor: 0x4936a4,
        baseColor: 0xf9cdff,
      });
    } catch (e) { console.error('[Vanta FOG]', e); }
  } else if (fogEl) {
    fogEl.classList.add('is-hidden');
  }

  document.querySelector('.quiz-start')?.addEventListener('click', () => {
    step = 0;
    answers.length = 0;
    fogEl?.classList.add('is-hidden'); // la bruma se disipa al comenzar
    show('questions');
    renderQuestion();
  });

  els.back.addEventListener('click', () => {
    if (step > 0) { step--; renderQuestion(); }
  });

  document.querySelector('.quiz-retry')?.addEventListener('click', () => {
    step = 0;
    answers.length = 0;
    hideReveal();
    fogEl?.classList.remove('is-hidden'); // vuelve la bruma en el intro
    emitReset();
    show('intro');
  });

  // Panel de ajuste del ascenso (?tune=1)
  if (tuneAscent && poses.length) {
    const panel = document.getElementById('tune-panel')!;
    panel.hidden = false;
    document.getElementById('quiz-fog')?.classList.add('is-hidden'); // ver el modelo al ajustar
    const stepLabel = panel.querySelector('[data-tune="step"]')!;
    panel.querySelector('[data-tune="total"]')!.textContent = String(questions.length);

    const FIELDS = ['camZ', 'camY', 'lookY', 'rotDeg', 'fov', 'tx', 'ty'] as const;
    const inputs: Record<string, HTMLInputElement> = {};
    const outputs: Record<string, HTMLElement> = {};
    FIELDS.forEach((f) => {
      inputs[f] = panel.querySelector(`[data-field="${f}"]`) as HTMLInputElement;
      outputs[f] = panel.querySelector(`[data-out="${f}"]`) as HTMLElement;
    });
    const sideBtns = Array.from(panel.querySelectorAll<HTMLElement>('[data-side]'));
    const original = JSON.parse(JSON.stringify(poses)) as Pose[];
    let tuneStep = 0;

    const syncControls = () => {
      const p = poses[tuneStep] as any;
      FIELDS.forEach((f) => { inputs[f].value = String(p[f]); outputs[f].textContent = String(p[f]); });
      sideBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.side === p.side));
      stepLabel.textContent = String(tuneStep + 1);
    };
    const gotoStep = (s: number) => {
      tuneStep = Math.max(0, Math.min(questions.length - 1, s));
      step = tuneStep;
      show('questions');
      renderQuestion();
      syncControls();
    };

    FIELDS.forEach((f) => {
      inputs[f].addEventListener('input', () => {
        (poses[tuneStep] as any)[f] = parseFloat(inputs[f].value);
        outputs[f].textContent = inputs[f].value;
        applyText(tuneStep);
        emitPose(tuneStep);
      });
    });
    sideBtns.forEach((b) => b.addEventListener('click', () => {
      poses[tuneStep].side = b.dataset.side as 'left' | 'right';
      applyText(tuneStep);
      syncControls();
    }));
    panel.querySelector('[data-tune="prev"]')!.addEventListener('click', () => gotoStep(tuneStep - 1));
    panel.querySelector('[data-tune="next"]')!.addEventListener('click', () => gotoStep(tuneStep + 1));
    panel.querySelector('[data-tune="reset"]')!.addEventListener('click', () => {
      poses[tuneStep] = JSON.parse(JSON.stringify(original[tuneStep]));
      gotoStep(tuneStep);
    });
    panel.querySelector('[data-tune="copy"]')!.addEventListener('click', async (e) => {
      const code = 'export const ascentPoses: AscentPose[] = ' +
        JSON.stringify(poses, null, 2).replace(/"(camY|camZ|lookY|rotDeg|fov|side|tx|ty)":/g, '$1:') + ';';
      try { await navigator.clipboard.writeText(code); } catch (_) { /* ignore */ }
      console.log('[ascent] Pega esto en src/data/ascent.ts:\n\n' + code);
      const btn = e.currentTarget as HTMLElement;
      const prev = btn.textContent;
      btn.textContent = '¡Copiado! (y en consola)';
      setTimeout(() => { btn.textContent = prev; }, 1900);
    });

    gotoStep(0);
  }

  // Editor del revelado (?tune=reveal)
  if (tuneReveal && revealPoses.length) {
    const panel = document.getElementById('tune-panel')!;
    panel.hidden = false;
    panel.querySelector('.tune__title')?.remove();
    // Muestra el revelado con una casa de ejemplo, sin scroll driving.
    fillReveal(houses[0]);
    quizSection.hidden = true;
    climbEl?.classList.add('is-off');
    fogEl?.classList.add('is-hidden');
    revealSection.hidden = false;
    revealSection.classList.add('is-tuning');
    revealSection.style.setProperty('--house-color', houses[0].color);
    window.dispatchEvent(new CustomEvent('reveal:init'));
    window.dispatchEvent(new CustomEvent('reveal:active', { detail: { on: true } }));
    window.dispatchEvent(new CustomEvent('reveal:house', { detail: { color: resolveColor(houses[0].color), logo: logos[houses[0].id] } }));

    // Pasos = revelado + 1 paso extra para el modelo FINAL (Peak Targon + logo).
    const peakPose = data.peakPose as RPose;
    const steps: RPose[] = [...revealPoses, peakPose];
    const peakIndex = revealPoses.length;

    const stepLabel = panel.querySelector('[data-tune="step"]')!;
    panel.querySelector('[data-tune="total"]')!.textContent = String(steps.length);
    const FIELDS = ['camZ', 'camY', 'lookY', 'rotDeg', 'fov', 'tx', 'ty'] as const;
    const inputs: Record<string, HTMLInputElement> = {};
    const outputs: Record<string, HTMLElement> = {};
    FIELDS.forEach((f) => {
      inputs[f] = panel.querySelector(`[data-field="${f}"]`) as HTMLInputElement;
      outputs[f] = panel.querySelector(`[data-out="${f}"]`) as HTMLElement;
    });
    const sideBtns = Array.from(panel.querySelectorAll<HTMLElement>('[data-side]'));
    const txLabel = panel.querySelector('.tune__row [data-field="tx"]')?.closest('.tune__row')?.querySelector('span');
    const tyLabel = panel.querySelector('.tune__row [data-field="ty"]')?.closest('.tune__row')?.querySelector('span');
    const original = JSON.parse(JSON.stringify(steps)) as RPose[];
    let tStep = 0;

    const applyRevealTune = () => {
      const p = steps[tStep];
      const isPeak = tStep === peakIndex;
      window.dispatchEvent(new CustomEvent('reveal:peak', { detail: { on: isPeak } }));
      // En el paso final se ocultan todas las captions (sólo el logo).
      revealCaps.forEach((c, i) => { c.style.opacity = (!isPeak && i === tStep) ? '1' : '0'; if (i < revealPoses.length) positionRevealCap(c, i); });
      window.dispatchEvent(new CustomEvent('reveal:pose', {
        detail: { camY: p.camY, camZ: p.camZ, lookY: p.lookY, rotDeg: p.rotDeg, fov: p.fov, tx: p.tx, ty: p.ty },
      }));
      // En el paso final, tx/ty controlan el LOGO
      if (txLabel) txLabel.textContent = isPeak ? 'Logo X' : 'Texto X';
      if (tyLabel) tyLabel.textContent = isPeak ? 'Logo Y' : 'Texto Y';
    };
    const sync = () => {
      const p = steps[tStep] as any;
      FIELDS.forEach((f) => { inputs[f].value = String(p[f]); outputs[f].textContent = String(p[f]); });
      sideBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.side === p.side));
      stepLabel.textContent = String(tStep + 1);
    };
    const goto = (s: number) => { tStep = Math.max(0, Math.min(steps.length - 1, s)); applyRevealTune(); sync(); };
    FIELDS.forEach((f) => inputs[f].addEventListener('input', () => {
      (steps[tStep] as any)[f] = parseFloat(inputs[f].value);
      outputs[f].textContent = inputs[f].value;
      applyRevealTune();
    }));
    sideBtns.forEach((b) => b.addEventListener('click', () => { steps[tStep].side = b.dataset.side as 'left' | 'right'; applyRevealTune(); sync(); }));
    panel.querySelector('[data-tune="prev"]')!.addEventListener('click', () => goto(tStep - 1));
    panel.querySelector('[data-tune="next"]')!.addEventListener('click', () => goto(tStep + 1));
    panel.querySelector('[data-tune="reset"]')!.addEventListener('click', () => { Object.assign(steps[tStep], JSON.parse(JSON.stringify(original[tStep]))); goto(tStep); });
    panel.querySelector('[data-tune="copy"]')!.addEventListener('click', async (e) => {
      const fmt = (o: any) => JSON.stringify(o, null, 2).replace(/"(camY|camZ|lookY|rotDeg|fov|side|tx|ty|slot)":/g, '$1:');
      const code = 'export const revealPoses: RevealPose[] = ' + fmt(revealPoses) + ';\n\n' +
        'export const peakPose: RevealPose = ' + fmt(peakPose) + ';';
      try { await navigator.clipboard.writeText(code); } catch (_) { /* noop */ }
      console.log('[reveal] Pega esto en src/data/reveal.ts:\n\n' + code);
      const btn = e.currentTarget as HTMLElement; const prev = btn.textContent;
      btn.textContent = '¡Copiado! (y en consola)';
      setTimeout(() => { btn.textContent = prev; }, 1900);
    });
    goto(0);
  }
</script>

