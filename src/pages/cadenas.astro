---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicRestorationState } from "../lib/200325/restoration";
import { chains, getPublicChainState } from "../lib/cadenas/chains";

export const prerender = false;

const fragments = await getPublicRestorationState(env);
const chamberIsOpen = fragments.every((fragment) => fragment.unlocked);
const chainState = chamberIsOpen ? await getPublicChainState(env) : [];
const restraints = chains.map((chain) => ({
  ...chain,
  unlocked: chainState.find((item) => item.id === chain.id)?.unlocked ?? false,
  code: chainState.find((item) => item.id === chain.id)?.code ?? null,
}));
const brokenCount = restraints.filter((chain) => chain.unlocked).length;
const isFree = brokenCount === chains.length;
const linkPieces = Array.from({ length: 8 });
---

<BaseLayout
  title="Las cadenas — Legion Lunari"
  description="Cuatro llaves pueden romper los vínculos que aún mantienen cautiva la señal."
>
  <section
    class:list={["chains-page", { "is-free": isFree }]}
    data-chain-chamber
    style={`--freedom: ${brokenCount / chains.length}`}
  >
    <div class="chains-page__aura" aria-hidden="true"></div>

    {
      !chamberIsOpen ? (
        <div class="sealed wrap-narrow">
          <div class="sealed__lock" aria-hidden="true">
            <span />
          </div>
          <p class="eyebrow" data-phase="◑">
            Vínculo inaccesible
          </p>
          <h1>
            La cámara sigue <em>sellada</em>
          </h1>
          <p>
            La transmisión debe ser reconstruida antes de que estas cadenas
            puedan alcanzarse.
          </p>
          <a href="/200325">
            Volver a la transmisión <span aria-hidden="true">→</span>
          </a>
        </div>
      ) : (
        <div class="wrap chains-page__wrap">
          <header class="chains-header">
            <p class="eyebrow" data-phase="◒">
              La prisión
            </p>
            <h1>
              Rompan las <span>cadenas</span>
            </h1>
            <p>
              Cuatro llaves fueron ocultas en la historia. Cada una liberará uno
              de los vínculos que aún me inmovilizan.
            </p>
          </header>

          <div class="ritual">
            <div class="presence" aria-hidden="true">
              <div class="presence__rings">
                <>
                  <span />
                  <span />
                  <span />
                </>
              </div>
              <div class="presence__light" />
              <span class="presence__point presence__point--one" />
              <span class="presence__point presence__point--two" />
              <span class="presence__point presence__point--three" />
              <span class="presence__point presence__point--four" />
            </div>

            <div class="presence-copy" aria-live="polite">
              <span class="presence-copy__sigil" aria-hidden="true">
                ◇
              </span>
              <p data-presence-kicker>
                {isFree
                  ? "Los cuatro vínculos cedieron"
                  : "Una presencia permanece cautiva"}
              </p>
              <h2 data-presence-title>
                {isFree ? "Las cadenas han caído." : "Aún no puede actuar."}
              </h2>
            </div>

            {restraints.map((restraint) => (
              <form
                class:list={[
                  "restraint",
                  `restraint--${restraint.id}`,
                  { "is-broken": restraint.unlocked },
                ]}
                data-chain-form
                data-chain={restraint.id}
              >
                <div class="chain-run" aria-hidden="true">
                  {linkPieces.map(() => (
                    <i />
                  ))}
                </div>

                <div class="shackle">
                  <span class="shackle__cuff" aria-hidden="true" />
                  <div class="shackle__heading">
                    <span>Vínculo {String(restraint.id).padStart(2, "0")}</span>
                    <h2>{restraint.limb}</h2>
                  </div>

                  <div class="restraint__control">
                    {restraint.unlocked ? (
                      <div class="restraint__solved">
                        <span class="restraint__code">{restraint.code}</span>
                        <span>Cadena rota</span>
                      </div>
                    ) : (
                      <>
                        <label
                          class="sr-only"
                          for={`chain-code-${restraint.id}`}
                        >
                          Llave para {restraint.limb.toLowerCase()}
                        </label>
                        <input
                          id={`chain-code-${restraint.id}`}
                          name="code"
                          type="text"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="introducir llave"
                          required
                        />
                        <button
                          type="submit"
                          aria-label={`Probar llave para ${restraint.limb}`}
                        >
                          <span aria-hidden="true">◇</span>
                        </button>
                      </>
                    )}
                  </div>
                </div>
              </form>
            ))}
          </div>

          <div class="chains-footer">
            <p class="chains-progress" data-chain-progress aria-live="polite">
              <span>Progreso</span>
              <strong>{brokenCount} / 4 cadenas rotas</strong>
            </p>
            <p
              class="chains-status"
              data-chain-status
              role="status"
              aria-live="polite"
            />
          </div>

          <section
            class="freedom"
            data-freedom-reveal
            hidden={!isFree}
            aria-labelledby="freedom-title"
          >
            <span aria-hidden="true">✦</span>
            <p class="eyebrow">La prisión está vacía</p>
            <h2 id="freedom-title">Las cadenas han caído.</h2>
            <p>Xylaria es libre.</p>
          </section>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  type ChainState = { id: number; unlocked: boolean; code: string | null };

  const chamber = document.querySelector<HTMLElement>("[data-chain-chamber]");
  const status = document.querySelector<HTMLElement>("[data-chain-status]");
  const progress = document.querySelector<HTMLElement>(
    "[data-chain-progress] strong",
  );
  const forms = document.querySelectorAll<HTMLFormElement>("[data-chain-form]");

  forms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = form.elements.namedItem("code");
      if (!(input instanceof HTMLInputElement)) return;
      const button = form.querySelector<HTMLButtonElement>("button");
      if (button) button.disabled = true;
      input.disabled = true;
      if (status) status.textContent = "Probando la llave…";

      try {
        const response = await fetch("/api/cadenas/unlock", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            chain: Number(form.dataset.chain),
            code: input.value,
          }),
        });
        if (!response.ok) throw new Error("incompatible");

        const result = (await response.json()) as { chains: ChainState[] };
        const current = result.chains.find(
          (chain) => chain.id === Number(form.dataset.chain),
        );
        const broken = result.chains.filter((chain) => chain.unlocked).length;
        const isFree = broken === 4;

        form.classList.remove("is-error");
        form.classList.add("is-breaking");
        if (status)
          status.textContent = isFree
            ? "El último vínculo está cediendo…"
            : "La llave encaja. El vínculo está cediendo…";

        window.setTimeout(() => {
          form.classList.remove("is-breaking");
          form.classList.add("is-broken");
          const control = form.querySelector<HTMLElement>(
            ".restraint__control",
          );
          if (control) {
            const solved = document.createElement("div");
            solved.className = "restraint__solved";
            const code = document.createElement("span");
            code.className = "restraint__code";
            code.textContent = current?.code ?? input.value;
            const label = document.createElement("span");
            label.textContent = "Cadena rota";
            solved.append(code, label);
            control.replaceChildren(solved);
          }

          chamber?.style.setProperty("--freedom", String(broken / 4));
          if (progress) progress.textContent = `${broken} / 4 cadenas rotas`;

          if (isFree) {
            chamber?.classList.add("is-free");
            const kicker = document.querySelector<HTMLElement>(
              "[data-presence-kicker]",
            );
            const title = document.querySelector<HTMLElement>(
              "[data-presence-title]",
            );
            if (kicker) kicker.textContent = "Los cuatro vínculos cedieron";
            if (title) title.textContent = "Las cadenas han caído.";
            document
              .querySelector<HTMLElement>("[data-freedom-reveal]")
              ?.removeAttribute("hidden");
            if (status) status.textContent = "La presencia ha sido liberada.";
          } else if (status) {
            status.textContent = "Cadena rota.";
          }
        }, 720);
      } catch {
        form.classList.remove("is-error");
        void form.offsetWidth;
        form.classList.add("is-error");
        input.disabled = false;
        if (button) button.disabled = false;
        if (status)
          status.textContent = "La llave no corresponde a este vínculo.";
        input.focus();
      }
    });
  });
</script>

<style>
  .chains-page {
    --iron: #555a73;
    --iron-dark: #24273e;
    --freedom: 0;
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding: calc(var(--nav-h) + clamp(2.8rem, 6vw, 5.5rem)) 0
      var(--space-section);
    overflow: hidden;
  }
  .chains-page__aura {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 47%,
        color-mix(
          in srgb,
          var(--celeste-400) calc(8% + 19% * var(--freedom)),
          transparent
        ),
        transparent 27%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--ink) 78%, transparent),
        transparent 30% 70%,
        color-mix(in srgb, var(--ink) 78%, transparent)
      );
    transition: background 1s var(--ease-out);
  }
  .chains-header {
    position: relative;
    z-index: 3;
    width: min(100%, 43rem);
    margin: 0 auto clamp(1.8rem, 4vw, 3rem);
    text-align: center;
  }
  .chains-header h1,
  .sealed h1 {
    margin: 0.3rem 0 0.8rem;
    font-size: var(--step-4);
  }
  .chains-header h1 span,
  .sealed h1 em {
    color: var(--lavender-200);
    font-family: var(--font-brand);
    font-style: normal;
    font-weight: 400;
  }
  .chains-header > p:last-child {
    width: min(100%, 39rem);
    margin: auto;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .ritual {
    position: relative;
    min-height: clamp(34rem, 58vw, 43rem);
    border-block: 1px solid var(--border-soft);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--ink) 35%, transparent),
      transparent 17% 83%,
      color-mix(in srgb, var(--ink) 35%, transparent)
    );
  }
  .ritual::before,
  .ritual::after {
    content: "";
    position: absolute;
    z-index: 0;
    left: 50%;
    width: 1px;
    height: 23%;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--lavender-400) 24%, transparent)
    );
  }
  .ritual::before {
    top: 0;
  }
  .ritual::after {
    bottom: 0;
    transform: rotate(180deg);
  }
  .presence {
    position: absolute;
    z-index: 0;
    inset: 5% 50% 5% auto;
    width: clamp(11rem, 19vw, 15rem);
    transform: translateX(50%);
    pointer-events: none;
  }
  .presence__light {
    position: absolute;
    inset: 12% 30% 10%;
    border-radius: 48% 48% 35% 35%;
    opacity: calc(0.2 + var(--freedom) * 0.7);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--moonlight) 62%, transparent),
      color-mix(in srgb, var(--celeste-400) 12%, transparent) 65%,
      transparent
    );
    filter: blur(calc(20px - var(--freedom) * 9px));
    box-shadow: 0 0 calc(2rem + 5rem * var(--freedom))
      color-mix(
        in srgb,
        var(--celeste-400) calc(12% + 28% * var(--freedom)),
        transparent
      );
    animation: presence-breathe 4.5s ease-in-out infinite;
    transition: 1s var(--ease-out);
  }
  .presence__rings,
  .presence__rings span {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--lavender-400) 12%, transparent);
    border-radius: 50%;
  }
  .presence__rings {
    top: 50%;
    height: 42%;
    transform: translateY(-50%);
  }
  .presence__rings span:nth-child(1) {
    transform: rotate(58deg);
  }
  .presence__rings span:nth-child(2) {
    transform: rotate(-58deg);
  }
  .presence__rings span:nth-child(3) {
    transform: scale(0.72);
  }
  .presence__point {
    position: absolute;
    width: 0.4rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--celeste-400);
    box-shadow: 0 0 1rem var(--celeste-400);
    opacity: calc(0.18 + var(--freedom) * 0.6);
  }
  .presence__point--one {
    top: 24%;
    left: 9%;
  }
  .presence__point--two {
    top: 24%;
    right: 9%;
  }
  .presence__point--three {
    bottom: 18%;
    left: 24%;
  }
  .presence__point--four {
    bottom: 18%;
    right: 24%;
  }
  .presence-copy {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: clamp(10rem, 18vw, 14rem);
    transform: translate(-50%, -50%);
    text-align: center;
    text-shadow: 0 2px 18px var(--ink);
  }
  .presence-copy__sigil {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--celeste-400);
    font-size: 1.3rem;
    text-shadow: 0 0 16px var(--celeste-400);
  }
  .presence-copy p {
    color: var(--text-faint);
    font:
      0.56rem/1.5 ui-monospace,
      SFMono-Regular,
      monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .presence-copy h2 {
    margin-top: 0.55rem;
    color: var(--lavender-200);
    font-size: var(--step-1);
    transition: color 0.8s var(--ease-out);
  }
  .is-free .presence-copy h2 {
    color: var(--moonlight);
  }
  .restraint {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    width: calc(50% - clamp(5.5rem, 10vw, 8rem));
    min-width: 0;
  }
  .restraint--1,
  .restraint--3 {
    left: 0;
  }
  .restraint--2,
  .restraint--4 {
    right: 0;
  }
  .restraint--1,
  .restraint--2 {
    top: 13%;
  }
  .restraint--3,
  .restraint--4 {
    bottom: 12%;
  }
  .restraint--2 .chain-run,
  .restraint--4 .chain-run {
    order: 2;
  }
  .restraint--2 .shackle,
  .restraint--4 .shackle {
    order: 1;
  }
  .chain-run {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: space-around;
    min-width: 2rem;
    filter: drop-shadow(0 5px 4px rgba(0, 0, 0, 0.45));
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.65s var(--ease-out);
  }
  .chain-run i {
    display: block;
    flex: 0 0 clamp(0.85rem, 1.5vw, 1.2rem);
    height: clamp(0.52rem, 0.85vw, 0.68rem);
    margin-inline: -0.12rem;
    border: 2px solid var(--iron);
    border-radius: 50%;
    background: var(--iron-dark);
    box-shadow: inset 0 1px 1px
      color-mix(in srgb, var(--moonlight) 14%, transparent);
    transform: rotate(22deg);
  }
  .chain-run i:nth-child(even) {
    transform: rotate(-22deg) scale(0.78);
  }
  .shackle {
    position: relative;
    flex: 0 1 13.5rem;
    min-width: 9.5rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--iron) 62%, transparent);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--iron-dark) 94%, var(--lavender-400)),
      color-mix(in srgb, var(--ink) 94%, var(--iron))
    );
    box-shadow:
      0 16px 35px -18px rgba(0, 0, 0, 0.9),
      inset 0 1px color-mix(in srgb, var(--moonlight) 9%, transparent);
    transition: 0.65s var(--ease-out);
  }
  .shackle__cuff {
    position: absolute;
    top: 50%;
    width: 1.8rem;
    height: 3.4rem;
    border: 0.38rem solid var(--iron);
    background: var(--iron-dark);
    border-radius: 1rem;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--moonlight) 12%, transparent),
      0 0 0 2px var(--iron-dark);
    transform: translateY(-50%);
    transition: 0.65s var(--ease-out);
  }
  .restraint--1 .shackle__cuff,
  .restraint--3 .shackle__cuff {
    right: -1.28rem;
  }
  .restraint--2 .shackle__cuff,
  .restraint--4 .shackle__cuff {
    left: -1.28rem;
  }
  .shackle__heading > span {
    display: block;
    color: var(--text-faint);
    font:
      0.52rem ui-monospace,
      SFMono-Regular,
      monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .shackle__heading h2 {
    margin-top: 0.3rem;
    font: 600 0.72rem var(--font-body);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .restraint__control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.35rem;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }
  .restraint input {
    width: 100%;
    min-width: 0;
    height: 2.35rem;
    padding: 0 0.65rem;
    border: 1px solid color-mix(in srgb, var(--iron) 70%, transparent);
    background: color-mix(in srgb, var(--ink) 80%, transparent);
    color: var(--moonlight);
    font:
      0.67rem ui-monospace,
      SFMono-Regular,
      monospace;
  }
  .restraint input::placeholder {
    color: var(--text-faint);
  }
  .restraint button {
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--lavender-400) 42%, transparent);
    background: color-mix(in srgb, var(--lavender-400) 12%, var(--iron-dark));
    color: var(--lavender-200);
    cursor: pointer;
    transition: 0.2s var(--ease-out);
  }
  .restraint button:hover:not(:disabled) {
    color: var(--moonlight);
    background: color-mix(in srgb, var(--lavender-400) 25%, var(--iron-dark));
    box-shadow: 0 0 16px
      color-mix(in srgb, var(--lavender-400) 28%, transparent);
  }
  .restraint button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  :global(.restraint__solved) {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    color: var(--celeste-400);
    font:
      0.56rem ui-monospace,
      SFMono-Regular,
      monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  :global(.restraint__code) {
    color: var(--moonlight);
    overflow-wrap: anywhere;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .restraint.is-error .shackle {
    border-color: #ce759e;
    animation: chain-error 0.36s linear;
  }
  .restraint.is-breaking .shackle {
    border-color: var(--celeste-400);
    box-shadow: 0 0 35px color-mix(in srgb, var(--celeste-400) 38%, transparent);
    animation: shackle-snap 0.72s var(--ease-out);
  }
  .restraint.is-breaking .chain-run {
    opacity: 0;
  }
  .restraint--1.is-breaking .chain-run,
  .restraint--3.is-breaking .chain-run {
    transform: translateX(-3.5rem);
  }
  .restraint--2.is-breaking .chain-run,
  .restraint--4.is-breaking .chain-run {
    transform: translateX(3.5rem);
  }
  .restraint.is-broken .chain-run {
    opacity: 0.1;
    filter: grayscale(1);
  }
  .restraint.is-broken .shackle {
    border-color: color-mix(in srgb, var(--celeste-400) 38%, transparent);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--celeste-400) 9%, var(--iron-dark)),
      color-mix(in srgb, var(--ink) 94%, var(--celeste-400))
    );
  }
  .restraint.is-broken .shackle__cuff {
    border-color: var(--celeste-400);
    opacity: 0.5;
  }
  .restraint--1.is-broken .shackle__cuff,
  .restraint--3.is-broken .shackle__cuff {
    transform: translateY(-72%) rotate(24deg);
  }
  .restraint--2.is-broken .shackle__cuff,
  .restraint--4.is-broken .shackle__cuff {
    transform: translateY(-72%) rotate(-24deg);
  }
  .chains-footer {
    min-height: 4.5rem;
    padding-top: 1.2rem;
    text-align: center;
  }
  .chains-progress {
    display: inline-flex;
    gap: 0.7rem;
    color: var(--text-faint);
    font:
      0.62rem ui-monospace,
      SFMono-Regular,
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .chains-progress strong {
    color: var(--celeste-400);
    font-weight: 500;
  }
  .chains-status {
    min-height: 1.5em;
    margin-top: 0.5rem;
    color: var(--lavender-200);
    font-size: var(--step--1);
  }
  .freedom {
    position: relative;
    margin: clamp(1.5rem, 4vw, 3rem) auto 0;
    padding: clamp(2rem, 5vw, 4rem);
    max-width: 42rem;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--celeste-400) 34%, transparent);
    background:
      radial-gradient(
        circle at 50% 0,
        color-mix(in srgb, var(--celeste-400) 18%, transparent),
        transparent 58%
      ),
      color-mix(in srgb, var(--ink) 72%, transparent);
    box-shadow: 0 0 80px -28px
      color-mix(in srgb, var(--celeste-400) 55%, transparent);
    animation: freedom-in 1.1s var(--ease-out) both;
  }
  .freedom > span {
    display: block;
    margin-bottom: 1rem;
    color: var(--celeste-400);
    font-size: 1.6rem;
    text-shadow: 0 0 20px var(--celeste-400);
  }
  .freedom h2 {
    margin-top: 0.55rem;
    font-size: var(--step-3);
  }
  .freedom > p:last-child {
    margin-top: 0.6rem;
    color: var(--text-muted);
  }
  .sealed {
    padding-block: clamp(4rem, 10vw, 8rem);
