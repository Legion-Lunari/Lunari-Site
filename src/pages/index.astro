---
import BaseLayout from '../layouts/BaseLayout.astro';
import TargonModel from '../components/TargonModel.astro';
import LunariLogo from '../components/LunariLogo.astro';

const DISCORD_URL = 'https://discord.com/invite/j2mEbRg9jc';

const pilares = [
  {
    phase: '🌒',
    title: 'Lorem ipsum dolor',
    body: 'Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium totam rem aperiam.',
  },
  {
    phase: '🌓',
    title: 'Consectetur elit',
    body: 'Eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo nemo enim.',
  },
  {
    phase: '🌔',
    title: 'Tempor incididunt',
    body: 'Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit sed quia consequuntur magni.',
  },
];

const vibes = [
  'Lorem ipsum dolor sit amet',
  'Consectetur adipiscing elit',
  'Sed do eiusmod tempor',
  'Incididunt ut labore et dolore',
  'Ut enim ad minim veniam',
  'Quis nostrud exercitation ullamco',
];
---

<BaseLayout>
  <section class="hero" id="hero">
   <div class="hero__pin">
    <div class="hero__stage" aria-hidden="true">
      <TargonModel class="hero__targon" />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <!-- Cada etapa aparece y se desvanece con el scroll de descenso -->
    <div class="hero__stages">
      <div class="hero__cap hero__cap--title" data-cap data-start="0" data-end="0.24">
        <div class="hero__cap-fog" data-hero-fog aria-hidden="true"></div>
        <h1 class="hero__title">Legion <span class="hero__title-accent">Lunari</span></h1>
        <p class="hero__cap-sub">Comunidad de Discord · League of Legends · LAN/LAS</p>
      </div>

      <div class="hero__cap hero__cap--left" data-cap data-narr data-start="0.24" data-end="0.48">
        <p class="hero__narr">En la cima del Monte Targon,<br />donde la luz roza las estrellas…</p>
      </div>

      <div class="hero__cap hero__cap--right" data-cap data-narr data-start="0.48" data-end="0.72">
        <p class="hero__narr">…desciende una hermandad<br />de invocadoras.</p>
      </div>

      <div class="hero__cap hero__cap--cta" data-cap data-start="0.72" data-end="1.3">
        <p class="hero__narr hero__narr--lead">
          Honesta, amigable y <span class="accent-text">mágica</span>.
        </p>
        <div class="hero__actions">
          <a href={DISCORD_URL} class="btn" target="_blank" rel="noopener">
            Unirse al Discord <span aria-hidden="true">→</span>
          </a>
          <a href="/quiz-de-casas" class="btn btn--ghost">Descubre tu casa</a>
        </div>
      </div>
    </div>

    <a href="#nosotras" class="hero__scroll" aria-label="Descender a Targon">
      <span></span>
    </a>
   </div>
  </section>

  <section class="section" id="nosotras">
    <div class="wrap-narrow intro stack" data-reveal>
      <p class="eyebrow">Quiénes somos</p>
      <h2 class="intro__title">
        Lorem ipsum dolor sit amet,
        <span class="accent-text">consectetur adipiscing elit.</span>
      </h2>
      <p class="lede">
        Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        Ut enim ad <span class="accent-text">minim veniam</span>, quis nostrud
        exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>
      <p>
        Duis aute irure dolor in reprehenderit in voluptate velit esse cillum
        dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non
        proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
      </p>
    </div>
  </section>

  <section class="section pilares-section">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Lorem ipsum dolor</p>
      <div class="pilares">
        {pilares.map((p, i) => (
          <article class="card pilar" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <h3 class="pilar__title">{p.title}</h3>
            <p class="pilar__body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section comunidad">
    <div class="wrap comunidad__grid">
      <div class="comunidad__text stack" data-reveal>
        <p class="eyebrow">Lorem ipsum</p>
        <h2>Lorem ipsum dolor sit<br />amet consectetur adipiscing.</h2>
        <p class="lede">
          Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet,
          consectetur, adipisci velit, sed quia non numquam eius modi tempora.
        </p>
        <a href="/about" class="btn btn--ghost">Lorem ipsum</a>
      </div>
      <ul class="vibes" data-reveal style="--reveal-delay:120ms">
        {vibes.map((v) => (
          <li class="vibe"><span class="vibe__star" aria-hidden="true">✦</span>{v}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap cta-final__inner card" data-reveal>
      <LunariLogo class="cta-final__logo" />
      <p class="eyebrow">Lorem ipsum</p>
      <h2 class="cta-final__title">
        Lorem ipsum dolor sit amet.<br />
        <span class="glow-text">Consectetur adipiscing elit?</span>
      </h2>
      <p class="lede">
        Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim.
      </p>
      <div class="hero__actions">
        <a href={DISCORD_URL} class="btn" target="_blank" rel="noopener">
          Unirse al Discord <span aria-hidden="true">→</span>
        </a>
        <a href="/quiz-de-casas" class="btn btn--ghost">Hacer el quiz de casas</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: el Monte Targon como pieza central. Estático por defecto;
     con .is-journey (lo añade el JS) se vuelve un recorrido de descenso. */
  .hero { position: relative; min-height: 100svh; }
  .hero__pin {
    position: relative;
    height: 100svh;
    display: flex;
    overflow: hidden;
    padding-top: 72px;
  }
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero__targon { position: absolute; inset: 0; pointer-events: auto; }

  /* Vela para legibilidad del texto sobre la montaña */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(130% 80% at 50% 40%, transparent 32%, color-mix(in srgb, var(--bg) 62%, transparent) 100%),
      linear-gradient(to top, var(--bg) 2%, transparent 42%);
  }

  .hero__stages {
    position: relative;
    z-index: 2;
    margin: auto;
    width: min(100% - var(--gutter) * 2, 720px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
  }

  .hero__title {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: clamp(3rem, 1.6rem + 6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .hero__title-accent { color: inherit; }
  .hero__cap-sub {
    margin-top: 1rem;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .hero__narr {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.7rem, 1rem + 2.6vw, 3rem);
    line-height: 1.16;
    color: var(--moonlight);
    text-wrap: balance;
  }
  .hero__narr--lead { margin-bottom: 1.8rem; }

  /* Neblina oscura tras el título para separarlo del monte (Vanta FOG) */
  .hero__cap--title {
    position: relative;
    padding: clamp(1.8rem, 4vw, 3rem) clamp(2rem, 6vw, 4rem);
    isolation: isolate;
  }
  .hero__cap--title > .hero__title,
  .hero__cap--title > .hero__cap-sub { position: relative; z-index: 1; }
  .hero__cap--title .hero__cap-sub { color: var(--text-muted); }

  .hero__cap-fog {
    position: absolute;
    inset: -30% -20%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    /* Base tenue; respaldo si Vanta no carga o hay reduced-motion */
    background: radial-gradient(58% 56% at 50% 52%,
      color-mix(in srgb, var(--ink) 46%, transparent) 0%,
      color-mix(in srgb, var(--night-900) 22%, transparent) 46%,
      transparent 74%);
    /* Máscara sin meseta: se difumina desde el centro, sin borde superior visible */
    -webkit-mask-image: radial-gradient(60% 58% at 50% 50%, #000 0%, transparent 72%);
    mask-image: radial-gradient(60% 58% at 50% 50%, #000 0%, transparent 72%);
  }
  .hero__cap-fog :global(canvas) { display: block; }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  /* En modo estático las narrativas intermedias no se muestran */
  .hero__cap[data-narr] { display: none; }

  /* Modo recorrido (JS + movimiento permitido) */
  .hero.is-journey { min-height: 265svh; }
  .hero.is-journey .hero__pin {
    position: sticky;
    top: 0;
    padding-top: 0;
    display: block;
  }
  .hero.is-journey .hero__stages {
    position: absolute;
    inset: 0;
    margin: 0;
    width: auto;
    display: block;
  }
  .hero.is-journey .hero__cap {
    position: absolute;
    left: 50%;
    top: 55%;
    width: min(100% - var(--gutter) * 2, 760px);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    will-change: opacity, transform;
  }
  .hero.is-journey .hero__cap[data-narr] { display: block; }

  /* Narrativas a los lados: no roban protagonismo al modelo del centro */
  .hero.is-journey .hero__cap--left {
    left: 27%;
    width: min(100% - var(--gutter) * 2, 420px);
    text-align: left;
  }
  .hero.is-journey .hero__cap--right {
    left: 73%;
    width: min(100% - var(--gutter) * 2, 420px);
    text-align: right;
  }
  @media (max-width: 820px) {
    .hero.is-journey .hero__cap--left,
    .hero.is-journey .hero__cap--right {
      left: 50%;
      width: min(100% - var(--gutter) * 2, 560px);
      text-align: center;
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    width: 26px; height: 42px;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 8px;
    z-index: 3;
  }
  .hero__scroll span {
    width: 4px; height: 8px;
    border-radius: 999px;
    background: var(--celeste-400);
    box-shadow: 0 0 10px var(--celeste-400);
    animation: scrollDot 1.8s var(--ease-out) infinite;
  }
  @keyframes scrollDot {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll span { animation: none; }
  }
  @media (max-width: 720px) {
    .hero__title { font-size: clamp(2.6rem, 1.6rem + 6vw, 4rem); }
  }

  /* Puente entre el hero (fondo --bg sólido) y las secciones (fondo fijo visible):
     desvanece el --bg del hero hacia la textura de estrellas para evitar el corte
     duro en la costura. Va tras el fondo fijo (z<0) y bajo el texto de la sección. */
  #nosotras::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 60vh;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 65%, transparent) 30%,
      color-mix(in srgb, var(--bg) 28%, transparent) 62%,
      transparent 100%
    );
  }

  .intro__title { font-size: var(--step-2); }

  /* Pilares */
  .pilares {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.4rem;
    margin-top: 2.5rem;
  }
  .pilar { padding: 2rem 1.8rem; transition: transform 0.4s var(--ease-out), border-color 0.4s var(--ease-out); }
  .pilar:hover { transform: translateY(-6px); border-color: var(--border); }
  .pilar__phase { font-size: 2rem; display: block; filter: saturate(0.2) brightness(1.5); }
  .pilar__title { font-size: var(--step-1); margin-top: 0.8rem; }
  .pilar__body { color: var(--text-muted); margin-top: 0.6rem; font-size: var(--step-0); }

  /* Comunidad */
  .comunidad__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (max-width: 820px) { .comunidad__grid { grid-template-columns: 1fr; } }

  .vibes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .vibe {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.3rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    font-size: var(--step-0);
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .vibe:hover { border-color: var(--border); transform: translateX(4px); }
  .vibe__star { color: var(--celeste-400); text-shadow: 0 0 12px var(--celeste-400); }

  /* CTA final */
  .cta-final__inner {
    position: relative;
    text-align: center;
    padding: clamp(2.5rem, 4vw, 4.5rem) clamp(1.5rem, 4vw, 4rem);
    overflow: hidden;
  }
  .cta-final__inner .hero__actions { justify-content: center; }
  .cta-final__logo { margin-bottom: 1.4rem; }
  .cta-final__title { font-size: var(--step-3); margin-block: 0.6rem 1rem; }
  .cta-final__inner > * { position: relative; z-index: 1; }
</style>

<script>
  // Recorrido de descenso: cada etapa de texto aparece y se desvanece
  // conforme la cámara desciende el Monte Targon.
  const hero = document.querySelector<HTMLElement>('.hero');
  const caps = Array.from(document.querySelectorAll<HTMLElement>('[data-cap]'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Neblina oscura tras el título (Vanta FOG), sólo con movimiento permitido.
  const fogEl = document.querySelector<HTMLElement>('[data-hero-fog]');
  if (fogEl && !reduced) {
    Promise.all([
      import('three'),
      // @ts-ignore: vanta no trae tipos
      import('vanta/dist/vanta.fog.min'),
    ]).then(([THREE, FOGmod]) => {
      const FOG = (FOGmod as any).default || FOGmod;
      FOG({
        el: fogEl,
        THREE,
        mouseControls: false,
        touchControls: false,
        gyroControls: false,
        minHeight: 120,
        minWidth: 120,
        blurFactor: 0.9,
        zoom: 0.7,
        speed: 1.0,
        highlightColor: 0x263a72,
        midtoneColor: 0x211a52,
        lowlightColor: 0x101038,
        baseColor: 0x0a0b24,
      });
    }).catch((e) => console.error('[HeroFog]', e));
  }

  if (hero && caps.length && !reduced) {
    hero.classList.add('is-journey');

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const smooth = (edge0: number, edge1: number, x: number) => {
      const t = clamp((x - edge0) / (edge1 - edge0));
      return t * t * (3 - 2 * t);
    };

    const stages = caps.map((el, i) => ({
      el,
      start: parseFloat(el.dataset.start || '0'),
      end: parseFloat(el.dataset.end || '1'),
      isCta: el.classList.contains('hero__cap--cta'),
      isFirst: i === 0,
    }));

    let ticking = false;
    const update = () => {
      ticking = false;
      const range = Math.max(1, hero.offsetHeight - window.innerHeight);
      const p = clamp(window.scrollY / range);

      const DRIFT = 66; // el texto viaja con la montaña (px)
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      for (const s of stages) {
        const span = Math.max(0.0001, s.end - s.start);
        const clampedLocal = Math.min(1, Math.max(0, (p - s.start) / span));
        // Una etapa termina de irse antes de que aparezca la siguiente (sin solape).
        const fadeIn = s.isFirst ? 1 : smooth(s.start, s.start + span * 0.3, p);
        const fadeOut = s.isCta ? 1 : 1 - smooth(s.end - span * 0.3, s.end, p);
        const vis = Math.min(fadeIn, fadeOut);
        const y = lerp(s.isFirst ? 0 : DRIFT * 0.5, -DRIFT * 0.5, clampedLocal);
        s.el.style.opacity = String(vis);
        s.el.style.transform = `translate(-50%, calc(-50% + ${y.toFixed(1)}px))`;
        s.el.style.pointerEvents = vis > 0.6 ? 'auto' : 'none';
      }
    };

    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
