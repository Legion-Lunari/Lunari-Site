---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { houses, type House } from "../../data/houses";

export function getStaticPaths() {
  return houses.map((house) => ({
    params: { house: house.id },
    props: { house },
  }));
}

interface Props {
  house: House;
}

const { house } = Astro.props;
const houseLogos: Record<string, string> = {
  febe: "/logos/Febe.svg",
  rea: "/logos/Rea.svg",
  dione: "/logos/Dione.svg",
  jano: "/logos/Jano.svg",
};
const logo = houseLogos[house.id];
---

<BaseLayout
  title={`${house.nombre} - Legión Lunari`}
  description={`Conoce ${house.nombre}, ${house.epiteto}, de Legión Lunari.`}
>
  <section class="house-hero section" style={`--house-color: ${house.color}`}>
    <div class="house-hero__glow" aria-hidden="true"></div>
    <div class="wrap house-hero__content">
      <p class="eyebrow" data-phase={house.simbolo}>Las casas de la luna</p>
      <img
        class="house-hero__crest"
        src={logo}
        alt={`Emblema de ${house.nombre}`}
      />
      <p class="house-hero__epithet">{house.epiteto}</p>
      <h1 class="display">{house.nombre}</h1>
      <p class="house-hero__motto">{house.lema}</p>
      <ul class="house-hero__traits" aria-label={`Rasgos de ${house.nombre}`}>
        {house.rasgos.map((trait) => <li>{trait}</li>)}
      </ul>
    </div>
    <a
      href="#house-details"
      class="house-hero__scroll"
      aria-label={`Leer sobre ${house.nombre}`}><span></span></a
    >
  </section>

  <section
    id="house-details"
    class="section house-details"
    style={`--house-color: ${house.color}`}
  >
    <div class="wrap house-details__story">
      {
        house.descripcion.map((paragraph, index) => (
          <div
            class:list={[
              "house-detail-row",
              { "house-detail-row--right": index % 2 === 1 },
            ]}
            data-reveal
          >
            <article class="house-detail">
              <p>{paragraph}</p>
            </article>
            <figure class="house-champion-card">
              <Image
                src={house.campeonas[index].imagen}
                alt={`${house.campeonas[index].nombre}, ${house.campeonas[index].titulo}`}
                width={1215}
                height={717}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <figcaption>
                <span>Campeona de la casa</span>
                <strong>{house.campeonas[index].nombre}</strong>
                <em>{house.campeonas[index].titulo}</em>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .house-hero {
    min-height: min(46rem, 88vh);
    display: grid;
    place-items: center;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + var(--space-section));
    text-align: center;
  }
  .house-hero__glow {
    position: absolute;
    width: min(42rem, 86vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--house-color) 32%, transparent),
      transparent 67%
    );
    filter: blur(12px);
    pointer-events: none;
  }
  .house-hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
  }
  .house-hero__crest {
    width: clamp(7rem, 16vw, 11rem);
    margin-top: 1.2rem;
    filter: drop-shadow(
      0 0 28px color-mix(in srgb, var(--house-color) 55%, transparent)
    );
  }
  .house-hero__epithet {
    color: var(--house-color);
    font-size: var(--step-1);
  }
  .house-hero__motto {
    max-width: 32rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    color: var(--text-muted);
  }
  .house-hero__traits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    padding: 0;
    margin-top: 0.7rem;
    list-style: none;
  }
  .house-hero__traits li {
    padding: 0.45rem 1rem;
    border: 1px solid color-mix(in srgb, var(--house-color) 75%, transparent);
    border-radius: 999px;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }
  .house-hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    z-index: 2;
    display: grid;
    width: 1.625rem;
    height: 2.625rem;
    justify-items: center;
    padding-top: 0.5rem;
    border: 1.5px solid color-mix(in srgb, var(--house-color) 72%, transparent);
    border-radius: 999px;
    transform: translateX(-50%);
    animation: scrollAppear 1s var(--ease-out) 0.8s both;
  }
  .house-hero__scroll::before {
    position: absolute;
    inset: -0.85rem;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--house-color) 35%, transparent),
      transparent 70%
    );
    content: "";
    animation: scrollHalo 2.4s var(--ease-out) infinite;
  }
  .house-hero__scroll::after {
    position: absolute;
    top: -1.35rem;
    left: 50%;
    color: color-mix(in srgb, var(--house-color) 75%, white);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-shadow: 0 0 8px color-mix(in srgb, var(--house-color) 60%, transparent);
    text-transform: uppercase;
    transform: translateX(-50%);
    content: "Desliza";
    animation: scrollLabel 2.4s ease-in-out infinite;
  }
  .house-hero__scroll span {
    width: 0.3rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--house-color);
    box-shadow: 0 0 12px var(--house-color);
    animation: scrollDot 1.6s var(--ease-out) infinite;
  }

  .house-details {
    padding-top: 0;
  }
  .house-details__story {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .house-detail-row {
    display: grid;
    grid-template-columns: minmax(0, 42rem) minmax(0, 1fr);
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 3vw, 4rem);
  }
  .house-detail-row--right {
    grid-template-columns: minmax(0, 1fr) minmax(0, 42rem);
  }
  .house-detail-row--right .house-detail {
    grid-column: 2;
  }
  .house-detail-row--right .house-champion-card {
    grid-row: 1;
    grid-column: 1;
  }
  .house-detail {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--surface) 90%, transparent),
      color-mix(in srgb, var(--house-color) 9%, var(--surface))
    );
    box-shadow: var(--shadow-card);
  }
  .house-detail p {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.7;
  }
  .house-champion-card {
    position: relative;
    width: 90%;
    min-height: 13rem;
    justify-self: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--house-color) 65%, transparent);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--house-color) 18%, transparent),
      var(--shadow-card);
  }
  .house-champion-card::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        transparent 25%,
        color-mix(in srgb, var(--ink) 25%, transparent) 48%,
        var(--ink) 100%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--house-color) 22%, transparent),
        transparent 58%
      );
    content: "";
    pointer-events: none;
  }
  .house-champion-card img {
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.9) contrast(1.05);
    transition:
      transform 0.7s var(--ease-out),
      filter 0.7s var(--ease-out);
  }
  .house-champion-card:hover img {
    filter: saturate(1.08) contrast(1.06);
    transform: scale(1.05);
  }
  .house-champion-card figcaption {
    position: absolute;
    right: 1.15rem;
    bottom: 1rem;
    left: 1.15rem;
    z-index: 1;
    display: grid;
    line-height: 1.15;
    text-shadow: 0 2px 12px var(--ink);
  }
  .house-champion-card figcaption span {
    margin-bottom: 0.3rem;
    color: color-mix(in srgb, var(--house-color) 68%, white);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .house-champion-card figcaption strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .house-champion-card figcaption em {
    margin-top: 0.18rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step--1);
  }

  @keyframes scrollAppear {
    to {
      opacity: 1;
    }
  }
  @keyframes scrollHalo {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.9);
    }
    50% {
      opacity: 0.65;
      transform: scale(1.2);
    }
  }
  @keyframes scrollLabel {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes scrollDot {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(1.05rem);
    }
  }
  .house-detail__marker {
    position: absolute;
    top: -0.75rem;
    left: clamp(1.25rem, 3vw, 2.25rem);
    padding-inline: 0.55rem;
    color: var(--house-color);
    background: var(--bg);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .house-detail-row,
    .house-detail-row--right {
      grid-template-columns: 1fr;
      gap: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--surface) 82%, transparent);
      box-shadow: var(--shadow-card);
    }
    .house-detail-row .house-champion-card,
    .house-detail-row--right .house-champion-card {
      grid-row: 1;
      grid-column: 1;
      min-height: 11rem;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .house-detail-row .house-champion-card img {
      min-height: 11rem;
    }
    .house-detail-row .house-detail,
    .house-detail-row--right .house-detail {
      grid-row: 2;
      grid-column: 1;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .house-hero__scroll,
    .house-hero__scroll::before,
    .house-hero__scroll::after,
    .house-hero__scroll span {
      animation: none;
    }
  }
</style>
