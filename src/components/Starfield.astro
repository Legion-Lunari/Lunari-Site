---
/**
 * Starfield
 */
---

<canvas id="starfield" aria-hidden="true"></canvas>
<div class="starfield-veil" aria-hidden="true"></div>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    /* Baja opacidad: es sólo el fondo, deja ver la aurora y el degradado */
    opacity: 0.55;
  }
  /* Velo que oscurece el fondo al pasar el hero (opacidad ligada al scroll) */
  .starfield-veil {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--bg-deep);
    opacity: 0;
  }
</style>

<script>
  const lowSpec =
    (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) ||
    ((navigator as any).deviceMemory && (navigator as any).deviceMemory <= 4);
  // Velo: oscurece el fondo conforme se deja atrás el hero (independiente del WebGL).
  const veil = document.querySelector<HTMLElement>(".starfield-veil");
  if (veil) {
    const hero = document.querySelector<HTMLElement>(".hero");
    const VEIL_MAX = 0.6;
    let vtick = false;
    const updateVeil = () => {
      vtick = false;
      const vh = innerHeight || 1;
      const start = hero
        ? Math.max(vh * 0.4, hero.offsetHeight - vh)
        : vh * 0.4;
      const p = Math.min(1, Math.max(0, (scrollY - start) / vh));
      veil.style.opacity = String(p * VEIL_MAX);
    };
    addEventListener(
      "scroll",
      () => {
        if (!vtick) {
          vtick = true;
          requestAnimationFrame(updateVeil);
        }
      },
      { passive: true },
    );
    addEventListener("resize", updateVeil, { passive: true });
    updateVeil();
  }

  const CFG = {
    count: lowSpec ? 6000 : 14000,
    radius: 25,
    fov: 65,

    main: {
      pointSizeMin: 0.0022,
      pointSizeMax: 0.008,
      opacity: 1.5,
      speed: 1.0,
    },
    bg: {
      pointSizeMin: 0.0012,
      pointSizeMax: 0.0026,
      opacity: 0.42,
      speed: 0.55,
    },

    yawSpeed: 0.012,
    pitchAmp: 0.06,
    pitchSpeed: 0.05,
    twinkle: 1.0,

    nebula: {
      bakeW: 512,
      bakeH: 256,
      octaves: 10,
      spatialFrequency: 2.1,
      brightness: 2.0,
      contrast: 0.06,
      pow: 3.0,
      falloff: 0.618,
      disc: 0.0,
      intensity: 0.42,
    },
    grain: 0.03,
    vignette: 0.55,
    paletteFlipY: true,

    detail: { src: "/detail.webp", amount: 1.0, yaw: 0.0, pitch: -0.25 },
  };

  // Paleta del sitio (32x32) embebida; el horneado de la nebulosa depende de ella.
  const PALETTE_URI =
    "data:image/png;base64,";

  const QUAD_VS = `
attribute vec2 aPos;
varying vec2 vUV;
void main(){ vUV = aPos * .5 + .5; gl_Position = vec4(aPos, 0., 1.); }
`;

  const BAKE_FS = `
precision highp float;
varying vec2 vUV;
uniform float _Falloff;
uniform float _SpatialFrequency;
uniform float _Brightness;
uniform float _Contrast;
uniform float _Pow;
uniform float _Disc;
uniform float _Intensity;
uniform vec3  _ColorBase;
uniform sampler2D uPalette;
vec2 hash21(float p) {
  p *= 1234.1234;
  vec3 p3 = fract(vec3(p) * vec3(.1031, .1030, .0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
vec3 color2(in float x) {
  return texture2D(uPalette, hash21(x)).rgb * sqrt(x + .4);
}
vec3 mod289(vec3 x){ return x - floor(x / 289.0) * 289.0; }
vec4 mod289(vec4 x){ return x - floor(x / 289.0) * 289.0; }
vec4 permute(vec4 x){ return mod289((x * 34.0 + 1.0) * x); }
vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - r * 0.85373472095314; }
vec4 snoise(vec3 v) {
  const vec2 C = vec2(1.0/6.0, 1.0/3.0);
  vec3 i  = floor(v + dot(v, vec3(C.y)));
  vec3 x0 = v - i + dot(i, vec3(C.x));
  vec3 g = step(x0.yzx, x0.xyz);
  vec3 l = 1.0 - g;
  vec3 i1 = min(g.xyz, l.zxy);
  vec3 i2 = max(g.xyz, l.zxy);
  vec3 x1 = x0 - i1 + C.x;
  vec3 x2 = x0 - i2 + C.y;
  vec3 x3 = x0 - 0.5;
  i = mod289(i);
  vec4 p = permute(permute(permute(i.z + vec4(0.0, i1.z, i2.z, 1.0))
                                 + i.y + vec4(0.0, i1.y, i2.y, 1.0))
                                 + i.x + vec4(0.0, i1.x, i2.x, 1.0));
  vec4 j = p - 49.0 * floor(p / 49.0);
  vec4 x_ = floor(j / 7.0);
  vec4 y_ = floor(j - 7.0 * x_);
  vec4 x = (x_ * 2.0 + 0.5) / 7.0 - 1.0;
  vec4 y = (y_ * 2.0 + 0.5) / 7.0 - 1.0;
  vec4 h = 1.0 - abs(x) - abs(y);
  vec4 b0 = vec4(x.xy, y.xy);
  vec4 b1 = vec4(x.zw, y.zw);
  vec4 s0 = floor(b0) * 2.0 + 1.0;
  vec4 s1 = floor(b1) * 2.0 + 1.0;
  vec4 sh = -step(h, vec4(0.0));
  vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
  vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
  vec3 g0 = vec3(a0.xy, h.x);
  vec3 g1 = vec3(a0.zw, h.y);
  vec3 g2 = vec3(a1.xy, h.z);
  vec3 g3 = vec3(a1.zw, h.w);
  vec4 norm = taylorInvSqrt(vec4(dot(g0,g0), dot(g1,g1), dot(g2,g2), dot(g3,g3)));
  g0 *= norm.x; g1 *= norm.y; g2 *= norm.z; g3 *= norm.w;
  vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
  vec4 m2 = m*m, m3 = m2*m, m4 = m2*m2;
  vec3 grad = -6.0*m3.x*x0*dot(x0,g0) + m4.x*g0
            + -6.0*m3.y*x1*dot(x1,g1) + m4.y*g1
            + -6.0*m3.z*x2*dot(x2,g2) + m4.z*g2
            + -6.0*m3.w*x3*dot(x3,g3) + m4.w*g3;
  vec4 px = vec4(dot(x0,g0), dot(x1,g1), dot(x2,g2), dot(x3,g3));
  return 42.0 * vec4(grad, dot(m4, px));
}
#define m33 mat3(-0.7373, 0.4562, 0.4980, 0, -0.7373, 0.6754, 0.6754, 0.4980, 0.5437)
float fbm31(vec3 q) {
  float a = 1.0, sum = 0.0;
  for (int i = 0; i < ${"${OCTAVES}"}; i++) {
    q = m33 * q.zxy;
    sum += snoise(q / a).x * a;
    a *= _Falloff;
  }
  return sum;
}
float nebulaNoise(vec3 p, vec3 n) {
  float f = fbm31(p * _SpatialFrequency);
  f += _Brightness;
  f *= _Contrast;
  f -= abs(n.y) * _Disc;
  f = max(f, 0.0);
  return pow(f, _Pow);
}
void main(void) {
  float lon = (vUV.x * 2.0 - 1.0) * 3.14159265;
  float lat = (vUV.y - 0.5) * 3.14159265;
  vec3 n = vec3(cos(lat) * sin(lon), sin(lat), cos(lat) * cos(lon));
  vec3 c  = nebulaNoise(n,        n) * color2(0.50);
       c += nebulaNoise(n + 1.0,  n) * color2(1.25);
       c += nebulaNoise(n + 2.0,  n) * color2(0.85);
  c = max(c, vec3(0.0)) * _Intensity + _ColorBase;
  gl_FragColor = vec4(sqrt(c), 1.0);
}
`;

  const BG_FS = `
precision mediump float;
varying vec2 vUV;
uniform sampler2D uNebula;
uniform sampler2D uDetail;
uniform mat3  uRotation;
uniform mat3  uDetailOrient;
uniform float uTanHalfFov;
uniform float uAspect;
uniform float uGrain;
uniform float uVignette;
uniform float uDetailAmount;
uniform highp float uTime;
float hash13(vec3 p3) {
  p3 = fract(p3 * .1031);
  p3 += dot(p3, p3.zyx + 31.32);
  return fract((p3.x + p3.y) * p3.z);
}
float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * .1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}
void main(void) {
  vec2 ndc = vUV * 2.0 - 1.0;
  vec3 ray = normalize(vec3(ndc.x * uAspect * uTanHalfFov, ndc.y * uTanHalfFov, -1.0));
  vec3 d = ray * uRotation;
  float u = atan(d.x, d.z) / 6.28318530 + 0.5;
  float v = asin(clamp(d.y, -1.0, 1.0)) / 3.14159265 + 0.5;
  vec3 c = texture2D(uNebula, vec2(u, v)).rgb;
  vec3 dd = d * uDetailOrient;
  if (dd.z > 0.001) {
    vec2 pd = dd.xy / dd.z;
    float edge = max(abs(pd.x), abs(pd.y));
    if (edge < 1.0) {
      vec3 dc = texture2D(uDetail, pd * 0.5 + 0.5).rgb;
      dc = max(vec3(0.0), dc * (1.0 - hash12(gl_FragCoord.xy + uTime) / 32.0));
      c += dc * 0.15 * uDetailAmount * smoothstep(1.0, 0.92, edge);
    }
  }
  vec2 q = vUV - 0.5;
  c *= 1.0 - dot(q, q) * uVignette;
  c += (hash13(vec3(gl_FragCoord.xy, uTime)) - 0.33) * uGrain;
  gl_FragColor = vec4(max(c, vec3(0.0)), 1.0);
}
`;

  const STARS_VS = `
attribute vec4 aData0;
attribute vec4 aData1;
#define aPos     aData0.xyz
#define aRandom  aData0.w
#define aRandom1 aData1.x
#define aRandom2 aData1.y
#define aRandom3 aData1.z
#define aRandom4 aData1.w
uniform mat4  uProjection;
uniform mat3  uRotation;
uniform float uRadius, uScreenHeight, uPointSizeMin, uPointSizeMax, uOpacity, uTwinkle;
uniform highp float uTime;
uniform sampler2D uPalette;
varying vec4 vColor;
vec2 hash21(float p) {
  p *= 1234.1234;
  vec3 p3 = fract(vec3(p) * vec3(.1031, .1030, .0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
vec3 color2(in float x) {
  return texture2D(uPalette, hash21(x)).rgb * sqrt(x + .4);
}
float light(float r, vec3 p) {
  return smoothstep(-1., 1., sin(r * uTime * .7 + r * 7.))
       + 2. * smoothstep(.7, 1., sin(p.z + p.x * 0.5 + uTime * .8));
}
void main(void) {
  vec3 p = uRotation * aPos * uRadius;
  gl_Position = uProjection * vec4(p, 1.);
  float size = mix(uPointSizeMin, uPointSizeMax, aRandom);
  gl_PointSize = size * uScreenHeight;
  float alpha = uOpacity * min(gl_PointSize, 1.) * aRandom4;
  float brightness = aRandom2 * (1. + uTwinkle * light(aRandom3, p));
  vColor = vec4(color2(aRandom1) * brightness, alpha);
}
`;

  const STARS_FS = `
precision mediump float;
varying vec4 vColor;
void main(void) {
  vec2 uv = gl_PointCoord.xy * 2. - 1.;
  float d = max(1. - length(uv), 0.);
  float a = d * d;
  a *= vColor.w;
  gl_FragColor = vec4(vColor.xyz * a, a);
}
`;

  const canvas = document.getElementById(
    "starfield",
  ) as HTMLCanvasElement | null;
  const gl =
    canvas?.getContext("webgl", {
      alpha: false,
      antialias: false,
      premultipliedAlpha: true,
    }) || null;

  if (canvas && gl) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS))
        throw new Error(gl.getShaderInfoLog(s) || "shader");
      return s;
    };
    const link = (
      vs: string,
      fs: string,
      uniforms: string[],
      attribs: string[],
    ) => {
      const p = gl.createProgram()!;
      gl.attachShader(p, compile(gl.VERTEX_SHADER, vs));
      gl.attachShader(p, compile(gl.FRAGMENT_SHADER, fs));
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS))
        throw new Error(gl.getProgramInfoLog(p) || "link");
      const u: Record<string, WebGLUniformLocation | null> = {},
        a: Record<string, number> = {};
      uniforms.forEach((n) => (u[n] = gl.getUniformLocation(p, n)));
      attribs.forEach((n) => (a[n] = gl.getAttribLocation(p, n)));
      return { p, u, a };
    };

    const bakeProg = link(
      QUAD_VS,
      BAKE_FS.replace("${OCTAVES}", String(CFG.nebula.octaves)),
      [
        "_Falloff",
        "_SpatialFrequency",
        "_Brightness",
        "_Contrast",
        "_Pow",
        "_Disc",
        "_Intensity",
        "_ColorBase",
        "uPalette",
      ],
      ["aPos"],
    );
    const bgProg = link(
      QUAD_VS,
      BG_FS,
      [
        "uNebula",
        "uDetail",
        "uRotation",
        "uDetailOrient",
        "uTanHalfFov",
        "uAspect",
        "uGrain",
        "uVignette",
        "uDetailAmount",
        "uTime",
      ],
      ["aPos"],
    );
    const starProg = link(
      STARS_VS,
      STARS_FS,
      [
        "uProjection",
        "uRotation",
        "uRadius",
        "uScreenHeight",
        "uPointSizeMin",
        "uPointSizeMax",
        "uOpacity",
        "uTime",
        "uTwinkle",
        "uPalette",
      ],
      ["aData0", "aData1"],
    );

    const quadBuf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quadBuf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );

    const makeLayer = (count: number) => {
      const d0 = new Float32Array(count * 4),
        d1 = new Float32Array(count * 4);
      for (let i = 0; i < count; i++) {
        const z = Math.random() * 2 - 1;
        const t = Math.random() * Math.PI * 2;
        const r = Math.sqrt(1 - z * z);
        const c = Math.random();
        d0.set([r * Math.cos(t), r * Math.sin(t), z, c * c * c], i * 4);
        d1.set(
          [Math.random(), Math.random(), Math.random(), Math.random()],
          i * 4,
        );
      }
      const mk = (arr: Float32Array) => {
        const b = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, b);
        gl.bufferData(gl.ARRAY_BUFFER, arr, gl.STATIC_DRAW);
        return b;
      };
      return { b0: mk(d0), b1: mk(d1), count };
    };
    const layerMain = makeLayer(CFG.count);
    const layerBG = makeLayer(CFG.count);

    const paletteTex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, paletteTex);
    gl.texImage2D(
      gl.TEXTURE_2D,
      0,
      gl.RGBA,
      1,
      1,
      0,
      gl.RGBA,
      gl.UNSIGNED_BYTE,
      new Uint8Array([255, 255, 255, 255]),
    );

    let nebulaTex: WebGLTexture | null = null;
    {
      const img = new Image();
      img.onload = () => {
        gl.bindTexture(gl.TEXTURE_2D, paletteTex);
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, CFG.paletteFlipY);
        gl.texImage2D(
          gl.TEXTURE_2D,
          0,
          gl.RGBA,
          gl.RGBA,
          gl.UNSIGNED_BYTE,
          img,
        );
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        nebulaTex = bakeNebula();
        if (reduced) requestAnimationFrame(loop);
      };
      img.src = PALETTE_URI;
    }

    const loadDetail = (src: string) => {
      const tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(
        gl.TEXTURE_2D,
        0,
        gl.RGBA,
        1,
        1,
        0,
        gl.RGBA,
        gl.UNSIGNED_BYTE,
        new Uint8Array([0, 0, 0, 255]),
      );
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      const img = new Image();
      img.onload = () => {
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
        gl.texImage2D(
          gl.TEXTURE_2D,
          0,
          gl.RGBA,
          gl.RGBA,
          gl.UNSIGNED_BYTE,
          img,
        );
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
        gl.generateMipmap(gl.TEXTURE_2D);
        gl.texParameteri(
          gl.TEXTURE_2D,
          gl.TEXTURE_MIN_FILTER,
          gl.LINEAR_MIPMAP_LINEAR,
        );
        if (reduced) requestAnimationFrame(loop);
      };
      img.onerror = () => console.warn("[Starfield] detail no cargó:", src);
      img.src = src;
      return tex;
    };
    const detailTex = loadDetail(CFG.detail.src);

    function bakeNebula() {
      const N = CFG.nebula;
      const tex = gl!.createTexture();
      gl!.bindTexture(gl!.TEXTURE_2D, tex);
      gl!.texImage2D(
        gl!.TEXTURE_2D,
        0,
        gl!.RGBA,
        N.bakeW,
        N.bakeH,
        0,
        gl!.RGBA,
        gl!.UNSIGNED_BYTE,
        null,
      );
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MIN_FILTER, gl!.LINEAR);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MAG_FILTER, gl!.LINEAR);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_S, gl!.REPEAT);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE);
      const fbo = gl!.createFramebuffer();
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, fbo);
      gl!.framebufferTexture2D(
        gl!.FRAMEBUFFER,
        gl!.COLOR_ATTACHMENT0,
        gl!.TEXTURE_2D,
        tex,
        0,
      );
      gl!.viewport(0, 0, N.bakeW, N.bakeH);
      gl!.useProgram(bakeProg.p);
      gl!.disable(gl!.BLEND);
      gl!.uniform1f(bakeProg.u._Falloff, N.falloff);
      gl!.uniform1f(bakeProg.u._SpatialFrequency, N.spatialFrequency);
      gl!.uniform1f(bakeProg.u._Brightness, N.brightness);
      gl!.uniform1f(bakeProg.u._Contrast, N.contrast);
      gl!.uniform1f(bakeProg.u._Pow, N.pow);
      gl!.uniform1f(bakeProg.u._Disc, N.disc);
      gl!.uniform1f(bakeProg.u._Intensity, N.intensity);
      gl!.uniform3fv(bakeProg.u._ColorBase, [18 / 255, 24 / 255, 40 / 255]);
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, paletteTex);
      gl!.uniform1i(bakeProg.u.uPalette, 0);
      gl!.bindBuffer(gl!.ARRAY_BUFFER, quadBuf);
      gl!.enableVertexAttribArray(bakeProg.a.aPos);
      gl!.vertexAttribPointer(bakeProg.a.aPos, 2, gl!.FLOAT, false, 0, 0);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, null);
      gl!.deleteFramebuffer(fbo);
      return tex;
    }

    const proj = new Float32Array(16);
    const perspective = (
      fovyDeg: number,
      aspect: number,
      near: number,
      far: number,
    ) => {
      const f = 1 / Math.tan((fovyDeg * Math.PI) / 360),
        nf = 1 / (near - far);
      proj.fill(0);
      proj[0] = f / aspect;
      proj[5] = f;
      proj[10] = (far + near) * nf;
      proj[11] = -1;
      proj[14] = 2 * far * near * nf;
    };
    const rot = new Float32Array(9);
    const rotation = (yaw: number, pitch: number) => {
      const cy = Math.cos(yaw),
        sy = Math.sin(yaw);
      const cx = Math.cos(pitch),
        sx = Math.sin(pitch);
      rot[0] = cy;
      rot[1] = sx * sy;
      rot[2] = -cx * sy;
      rot[3] = 0;
      rot[4] = cx;
      rot[5] = sx;
      rot[6] = sy;
      rot[7] = -sx * cy;
      rot[8] = cx * cy;
    };

    const detailOrient = new Float32Array(9);
    {
      const yaw = CFG.detail.yaw,
        pitch = CFG.detail.pitch;
      const cy = Math.cos(yaw),
        sy = Math.sin(yaw);
      const cx = Math.cos(pitch),
        sx = Math.sin(pitch);
      detailOrient[0] = cy;
      detailOrient[1] = sx * sy;
      detailOrient[2] = -cx * sy;
      detailOrient[3] = 0;
      detailOrient[4] = cx;
      detailOrient[5] = sx;
      detailOrient[6] = sy;
      detailOrient[7] = -sx * cy;
      detailOrient[8] = cx * cy;
    }

    let vw = 0,
      vh = 0,
      aspect = 1;
    const resize = () => {
      const dpr = 1; // fondo: 1x basta y evita saturar el compositor
      const w = Math.round(innerWidth * dpr),
        h = Math.round(innerHeight * dpr);
      if (canvas.width === w && canvas.height === h) return;
      canvas.width = w;
      canvas.height = h;
      vw = w;
      vh = h;
      aspect = w / h;
      perspective(CFG.fov, aspect, 0.1, 100);
      if (reduced) requestAnimationFrame(loop);
    };
    addEventListener("resize", resize);
    resize();

    gl.disable(gl.DEPTH_TEST);
    const tanHalfFov = Math.tan((CFG.fov * Math.PI) / 360);

    const drawStarLayer = (
      layer: { b0: WebGLBuffer | null; b1: WebGLBuffer | null; count: number },
      opts: {
        pointSizeMin: number;
        pointSizeMax: number;
        opacity: number;
        speed: number;
      },
      t: number,
    ) => {
      rotation(
        t * CFG.yawSpeed * opts.speed,
        Math.sin(t * CFG.pitchSpeed) * CFG.pitchAmp * opts.speed,
      );
      gl.uniformMatrix3fv(starProg.u.uRotation, false, rot);
      gl.uniform1f(starProg.u.uPointSizeMin, opts.pointSizeMin);
      gl.uniform1f(starProg.u.uPointSizeMax, opts.pointSizeMax);
      gl.uniform1f(starProg.u.uOpacity, opts.opacity);
      gl.bindBuffer(gl.ARRAY_BUFFER, layer.b0);
      gl.enableVertexAttribArray(starProg.a.aData0);
      gl.vertexAttribPointer(starProg.a.aData0, 4, gl.FLOAT, false, 0, 0);
      gl.bindBuffer(gl.ARRAY_BUFFER, layer.b1);
      gl.enableVertexAttribArray(starProg.a.aData1);
      gl.vertexAttribPointer(starProg.a.aData1, 4, gl.FLOAT, false, 0, 0);
      gl.drawArrays(gl.POINTS, 0, layer.count);
    };

    const start = performance.now();
    const frame = (now: number) => {
      const t = reduced ? 0 : (now - start) / 1000;
      gl.viewport(0, 0, vw, vh);

      gl.disable(gl.BLEND);
      if (!nebulaTex) {
        gl.clearColor(0, 0, 0, 1);
        gl.clear(gl.COLOR_BUFFER_BIT);
      } else {
        gl.useProgram(bgProg.p);
        rotation(
          t * CFG.yawSpeed * CFG.main.speed,
          Math.sin(t * CFG.pitchSpeed) * CFG.pitchAmp * CFG.main.speed,
        );
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, nebulaTex);
        gl.uniform1i(bgProg.u.uNebula, 0);
        gl.activeTexture(gl.TEXTURE1);
        gl.bindTexture(gl.TEXTURE_2D, detailTex);
        gl.uniform1i(bgProg.u.uDetail, 1);
        gl.uniformMatrix3fv(bgProg.u.uRotation, false, rot);
        gl.uniformMatrix3fv(bgProg.u.uDetailOrient, false, detailOrient);
        gl.uniform1f(bgProg.u.uTanHalfFov, tanHalfFov);
        gl.uniform1f(bgProg.u.uAspect, aspect);
        gl.uniform1f(bgProg.u.uGrain, CFG.grain);
        gl.uniform1f(bgProg.u.uVignette, CFG.vignette);
        gl.uniform1f(bgProg.u.uDetailAmount, CFG.detail.amount);
        gl.uniform1f(bgProg.u.uTime, (10.0 * t) % 1000.0);
        gl.bindBuffer(gl.ARRAY_BUFFER, quadBuf);
        gl.enableVertexAttribArray(bgProg.a.aPos);
        gl.vertexAttribPointer(bgProg.a.aPos, 2, gl.FLOAT, false, 0, 0);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      }

      gl.enable(gl.BLEND);
      gl.blendFunc(gl.ONE, gl.ONE);
      gl.useProgram(starProg.p);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, paletteTex);
      gl.uniform1i(starProg.u.uPalette, 0);
      gl.uniformMatrix4fv(starProg.u.uProjection, false, proj);
      gl.uniform1f(starProg.u.uRadius, CFG.radius);
      gl.uniform1f(starProg.u.uScreenHeight, vh);
      gl.uniform1f(starProg.u.uTime, t);
      gl.uniform1f(starProg.u.uTwinkle, reduced ? 0 : CFG.twinkle);
      drawStarLayer(layerBG, CFG.bg, t);
      drawStarLayer(layerMain, CFG.main, t);
    };

    // Cap a ~30fps: es un fondo, y deja aire al hilo principal (reveal, scroll…).
    const FRAME_MS = 1000 / 30;
    let lastDraw = 0;
    function loop(now: number) {
      if (now - lastDraw >= FRAME_MS) {
        lastDraw = now;
        frame(now);
      }
      if (!reduced) requestAnimationFrame(loop);
    }

    const startLoop = () => {
      requestAnimationFrame(loop);
    };

    if ("requestIdleCallback" in window) {
      requestIdleCallback(startLoop, { timeout: 500 });
    } else setTimeout(startLoop, 100);
  }
</script>
