---
/**
 * SiteLoader: velo de carga que cubre la página hasta que termina de cargar
 * (evento load, con mínimo de 350ms para no parpadear y tope de 4s para no
 * retener nunca). Al ocultarse marca <html>.is-loaded y emite "lunari:loaded",
 * que las animaciones de entrada usan como pistoletazo de salida.
 */
---

<div id="site-loader" aria-hidden="true">
  <img src="/legion-lunari-logo.svg" alt="" width="72" height="72" />
</div>
<noscript>
  <style>
    #site-loader { display: none; }
  </style>
</noscript>

<style>
  #site-loader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    background: var(--bg-deep);
    transition: opacity 0.5s var(--ease-out), visibility 0.5s;
  }
  #site-loader.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  #site-loader img {
    width: 72px;
    height: 72px;
    filter: drop-shadow(0 0 26px color-mix(in srgb, var(--celeste-400) 55%, transparent));
    animation: loaderPulse 1.6s ease-in-out infinite;
  }
  @keyframes loaderPulse {
    0%, 100% { opacity: 0.55; transform: scale(0.94); }
    50% { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    #site-loader img { animation: none; }
  }
</style>

<script>
  const loader = document.getElementById('site-loader');
  if (loader) {
    const MIN = 350;
    const t0 = performance.now();
    let finished = false;
    const done = () => {
      if (finished) return;
      finished = true;
      loader.classList.add('is-done');
      document.documentElement.classList.add('is-loaded');
      document.dispatchEvent(new Event('lunari:loaded'));
      setTimeout(() => loader.remove(), 650);
    };
    const finish = () =>
      setTimeout(done, Math.max(0, MIN - (performance.now() - t0)));
    if (document.readyState === 'complete') finish();
    else addEventListener('load', finish, { once: true });
    setTimeout(done, 4000); // tope duro: jamás retener la página
  }
</script>
