---
/** Navegación principal. Transparente sobre el hero, con blur al hacer scroll. */
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Nosotras' },
  { href: '/quiz-de-casas', label: 'Quiz de Casas' },
];
const DISCORD_URL = 'https://discord.com/invite/j2mEbRg9jc';
---

<header class="nav" id="site-nav">
  <div class="nav__inner wrap">
    <a href="/" class="nav__brand" aria-label="Legion Lunari — Inicio">
      <img src="/legion-lunari-logo.svg" alt="" width="34" height="34" />
      <span class="nav__brand-text">Legion&nbsp;Lunari</span>
    </a>

    <nav class="nav__links" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} class:list={['nav__link', { 'is-active': isActive(l.href) }]}>
          {l.label}
        </a>
      ))}
    </nav>

    <a href={DISCORD_URL} class="btn nav__cta" target="_blank" rel="noopener">
      Unirse
    </a>

    <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="mobile-menu" hidden>
    {links.map((l) => (
      <a href={l.href} class:list={['nav__mobile-link', { 'is-active': isActive(l.href) }]}>
        {l.label}
      </a>
    ))}
    <a href={DISCORD_URL} class="btn nav__mobile-cta" target="_blank" rel="noopener">Unirse al Discord</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out), backdrop-filter 0.4s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: color-mix(in srgb, var(--night-900) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--border-soft);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 72px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    color: var(--moonlight);
    margin-right: auto;
  }
  .nav__brand img { filter: drop-shadow(0 0 10px color-mix(in srgb, var(--celeste-400) 55%, transparent)); }

  .nav__links { display: flex; gap: 0.4rem; }
  .nav__link {
    position: relative;
    padding: 0.5em 0.9em;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-radius: 999px;
    transition: color 0.25s var(--ease-out);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 50%; bottom: 0.2em;
    width: 0; height: 2px;
    background: var(--celeste-400);
    box-shadow: 0 0 10px var(--celeste-400);
    transform: translateX(-50%);
    transition: width 0.3s var(--ease-out);
  }
  .nav__link:hover { color: var(--moonlight); }
  .nav__link:hover::after,
  .nav__link.is-active::after { width: 55%; }
  .nav__link.is-active { color: var(--moonlight); }

  .nav__cta { padding: 0.6em 1.3em; font-size: var(--step--1); }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 42px; height: 42px;
    align-items: center; justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 12px;
    cursor: pointer;
  }
  .nav__toggle span {
    display: block; width: 20px; height: 2px;
    background: var(--moonlight);
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }
  .nav.is-open .nav__toggle span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav.is-open .nav__toggle span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .nav__mobile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem var(--gutter) 1.6rem;
    background: color-mix(in srgb, var(--night-900) 92%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav__mobile-link {
    padding: 0.8em 0.4em;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav__mobile-link.is-active { color: var(--celeste-400); }
  .nav__mobile-cta { margin-top: 0.8rem; justify-content: center; }

  @media (max-width: 820px) {
    .nav__links, .nav__cta { display: none; }
    .nav__toggle { display: flex; }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = nav?.querySelector('.nav__toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');

  // Blur al hacer scroll
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil
  toggle?.addEventListener('click', () => {
    const open = nav!.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      if (menu) menu.hidden = true;
    })
  );
</script>
