---
const DISCORD_URL = "https://discord.com/invite/j2mEbRg9jc";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <img src="/legion-lunari-logo.svg" alt="" width="48" height="48" />
      <p class="footer__tag">
        Un refugio nocturno para invocadoras.<br />
        <span class="accent-text">Honestas, unidas, brillantes.</span>
      </p>

      <div>

      </div>
    </div>

    <nav class="footer__nav" aria-label="Pie">
      <a href="/">Inicio</a>
      <a href="/about">Nosotras</a>
      <a href="/quiz-de-casas">Quiz de Casas</a>
      <a href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>
    </nav>
  </div>

  <div class="wrap footer__bottom">
    <span>© {year} Legion Lunari · Comunidad LoL/LAN para mujeres</span>
    <span class="footer__moon">Hecho bajo la luna</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-soft);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem;
    margin-top: var(--space-section);
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--ink) 60%, transparent)
    );
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
    align-items: flex-start;
  }
  .footer__brand {
    display: flex;
    gap: 1rem;
    align-items: center;
    max-width: 360px;
  }
  .footer__brand img {
    filter: drop-shadow(
      0 0 14px color-mix(in srgb, var(--celeste-400) 45%, transparent)
    );
  }
  .footer__tag {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }
  .footer__nav a {
    color: var(--text-muted);
    transition: color 0.25s var(--ease-out);
    width: fit-content;
  }
  .footer__nav a:hover {
    color: var(--celeste-400);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
</style>
