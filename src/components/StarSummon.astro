---
/**
 * StarSummon: una estrella fugaz recorre la página "invocando" los elementos.
 * El cometa entra desde arriba, vuela en arcos de waypoint en waypoint y al
 * tocar cada elemento lo enciende: los sueltos emergen con un destello y las
 * cards marcadas con .summon-card se abren en círculo desde su medallón
 * mientras el cometa las orbita un instante.
 *
 * Uso: envolver la zona en <div class="summon-stage">, marcar cada objetivo
 * con data-summon="n" (orden de visita; las cards además con .summon-card) e
 * incluir este componente una vez. Con prefers-reduced-motion todo aparece
 * directo, sin cometa.
 */
---

<style is:global>
  .summon-stage {
    position: relative;
  }
  .summon-stage > canvas.summon-canvas {
    position: absolute;
    inset: -60px;
    width: calc(100% + 120px);
    height: calc(100% + 120px);
    max-width: none;
    pointer-events: none;
    z-index: 3;
  }

  /* Solo se ocultan cuando el script arma el escenario (.summon-ready);
     sin JS o con reduced-motion todo queda visible */
  .summon-stage.summon-ready [data-summon]:not(.summon-card) {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
  }
  .summon-stage.summon-ready [data-summon]:not(.summon-card).sm-lit {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out),
      filter 0.9s var(--ease-out);
  }
  /* Flash breve al encenderse */
  .summon-stage.summon-ready .sm-lit {
    animation: smFlash 0.9s var(--ease-out);
  }
  @keyframes smFlash {
    0% {
      filter: brightness(2) drop-shadow(0 0 16px rgba(233, 226, 248, 0.75));
    }
    100% {
      filter: brightness(1);
    }
  }

  /* Las cards se abren en círculo desde el medallón superior */
  .summon-stage.summon-ready .summon-card {
    clip-path: circle(0% at 50% 2%);
  }
  .summon-stage.summon-ready .summon-card.sm-lit {
    clip-path: circle(165% at 50% 2%);
    transition: clip-path 1.25s cubic-bezier(0.22, 1, 0.36, 1);
    animation: none; /* el wipe circular ya es el protagonismo */
  }

  @media (prefers-reduced-motion: reduce) {
    .summon-stage [data-summon] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      clip-path: none !important;
    }
    .summon-stage > canvas.summon-canvas {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const TAU = Math.PI * 2;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const PAD = 60; // debe coincidir con el inset del canvas

    // Paleta del sitio
    const CREAM = "#f5ead9";
    const LILA = "#b9a3f0";
    const PALE = "#eef0ff";

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);
    const easeInOut = (t: number) =>
      t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;

    interface Pt {
      x: number;
      y: number;
    }
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      life: number;
      born: number;
      pale: boolean;
      star: boolean;
    }

    // Estrella de 4 puntas esbelta con degradado crema→lila
    function drawSpark(
      ctx: CanvasRenderingContext2D,
      x: number,
      y: number,
      size: number,
      rot: number,
      alpha: number,
      pale = false,
    ) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rot);
      ctx.globalAlpha = alpha;
      const vy = size * 1.25,
        vx = size * 0.8,
        pinch = 0.13;
      if (pale) {
        ctx.fillStyle = PALE;
      } else {
        const g = ctx.createLinearGradient(0, -vy, 0, vy);
        g.addColorStop(0, CREAM);
        g.addColorStop(1, LILA);
        ctx.fillStyle = g;
      }
      ctx.beginPath();
      ctx.moveTo(0, -vy);
      ctx.quadraticCurveTo(vx * pinch, -vy * pinch, vx, 0);
      ctx.quadraticCurveTo(vx * pinch, vy * pinch, 0, vy);
      ctx.quadraticCurveTo(-vx * pinch, vy * pinch, -vx, 0);
      ctx.quadraticCurveTo(-vx * pinch, -vy * pinch, 0, -vy);
      ctx.fill();
      ctx.restore();
    }

    function qPoint(a: Pt, c: Pt, b: Pt, t: number): Pt {
      const u = 1 - t;
      return {
        x: u * u * a.x + 2 * u * t * c.x + t * t * b.x,
        y: u * u * a.y + 2 * u * t * c.y + t * t * b.y,
      };
    }

    function runStage(stage: HTMLElement) {
      const targets = Array.from(
        stage.querySelectorAll<HTMLElement>("[data-summon]"),
      ).sort((a, b) => +(a.dataset.summon || 0) - +(b.dataset.summon || 0));
      if (!targets.length) return;

      const canvas = document.createElement("canvas");
      canvas.className = "summon-canvas";
      stage.appendChild(canvas);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const srect = stage.getBoundingClientRect();
      const w = srect.width + PAD * 2,
        h = srect.height + PAD * 2;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      const ctx = canvas.getContext("2d")!;
      ctx.scale(dpr, dpr);

      // Waypoints: centro de cada objetivo (o el medallón, en las cards)
      const anchors: Pt[] = targets.map((el) => {
        const r = el.getBoundingClientRect();
        const x = r.left - srect.left + PAD + r.width / 2;
        const y =
          el.classList.contains("summon-card") ||
          el.classList.contains("summon-burst")
            ? r.top - srect.top + PAD + r.height * 0.02
            : r.top - srect.top + PAD + r.height / 2;
        return { x, y };
      });

      const points: Pt[] = [
        { x: anchors[0].x - Math.min(240, w * 0.3), y: -20 }, // entrada en diagonal
        ...anchors,
        { x: anchors[anchors.length - 1].x + 160, y: h + 40 }, // salida
      ];

      interface Seg {
        a: Pt;
        b: Pt;
        c: Pt;
        dur: number;
      }
      const segs: Seg[] = [];
      for (let i = 0; i < points.length - 1; i++) {
        const a = points[i],
          b = points[i + 1];
        const dx = b.x - a.x,
          dy = b.y - a.y;
        const dist = Math.hypot(dx, dy) || 1;
        const toCard =
          i < targets.length &&
          (targets[i].classList.contains("summon-card") ||
            targets[i].classList.contains("summon-burst"));
        let c: Pt;
        if (toCard) {
          // Salto en arco por encima al ir hacia un medallón
          c = {
            x: (a.x + b.x) / 2,
            y: Math.min(a.y, b.y) - Math.max(70, dist * 0.3),
          };
        } else {
          const bow = (i % 2 ? 1 : -1) * dist * 0.18;
          c = {
            x: (a.x + b.x) / 2 - (dy / dist) * bow,
            y: (a.y + b.y) / 2 + (dx / dist) * bow,
          };
        }
        segs.push({ a, b, c, dur: Math.min(Math.max(dist * 1.15, 400), 950) });
      }

      const particles: Particle[] = [];
      const trail: Pt[] = [];
      let seg = 0;
      let segStart = performance.now();
      let holdUntil = 0;
      let holdAnchor: Pt | null = null;
      let holdPh = 0;
      let finished = false;

      function emit(x: number, y: number, n: number, speed: number) {
        for (let i = 0; i < n; i++) {
          const a = rand(0, TAU);
          const v = rand(0.2, 1) * speed;
          particles.push({
            x,
            y,
            vx: Math.cos(a) * v,
            vy: Math.sin(a) * v * 0.8,
            size: rand(1.3, 3.6),
            life: rand(360, 720),
            born: performance.now(),
            pale: Math.random() < 0.4,
            star: Math.random() < 0.4,
          });
        }
      }

      function arrive(idx: number, at: Pt, now: number) {
        const el = targets[idx];
        el.classList.add("sm-lit");
        emit(at.x, at.y, Math.round(rand(10, 16)), 3.6);
        if (el.classList.contains("summon-burst")) {
          const cards = el.querySelectorAll<HTMLElement>(".summon-card");
          cards.forEach((c) => c.classList.add("sm-lit"));
          emit(at.x, at.y, 32, 5.2); // bigger flash for the whole batch
        }
        const isCard =
          el.classList.contains("summon-card") ||
          el.classList.contains("summon-burst");
        holdAnchor = isCard ? at : null;
        holdPh = rand(0, TAU);
        holdUntil = now + (isCard ? 560 : 170);
      }

      function frame(now: number) {
        ctx.clearRect(0, 0, w, h);
        let head: Pt | null = null;
        let rot = 0;

        if (holdUntil > now) {
          // Orbita el medallón mientras la card se abre
          if (holdAnchor) {
            const oa = holdPh + ((now - (holdUntil - 560)) / 560) * TAU * 1.2;
            head = {
              x: holdAnchor.x + Math.cos(oa) * 26,
              y: holdAnchor.y + Math.sin(oa) * 16,
            };
            rot = oa + Math.PI / 2;
          } else {
            head = trail[trail.length - 1] || null;
          }
        } else if (seg < segs.length) {
          if (holdAnchor || holdUntil) {
            segStart = Math.max(segStart, holdUntil);
            holdAnchor = null;
            holdUntil = 0;
          }
          const s = segs[seg];
          const p = clamp01((now - segStart) / s.dur);
          const e = easeInOut(p);
          head = qPoint(s.a, s.c, s.b, e);
          const ahead = qPoint(s.a, s.c, s.b, Math.min(e + 0.02, 1));
          rot = Math.atan2(ahead.y - head.y, ahead.x - head.x) + Math.PI / 2;
          if (p >= 1) {
            if (seg < targets.length) arrive(seg, s.b, now);
            seg++;
            segStart = holdUntil || now;
          }
        } else if (!finished) {
          finished = true;
          stage.classList.add("summon-done");
        }

        if (head && !finished) {
          trail.push({ x: head.x, y: head.y });
          if (trail.length > 16) trail.shift();
          if (Math.random() < 0.75) emit(head.x, head.y, 1, 1.6);
        } else if (trail.length) {
          trail.shift(); // la estela se retrae al terminar
        }

        // Estela cónica
        ctx.lineCap = "round";
        for (let i = 1; i < trail.length; i++) {
          const a = trail[i - 1],
            b = trail[i];
          const k = i / trail.length;
          ctx.globalAlpha = k * 0.4;
          ctx.strokeStyle = i % 2 ? PALE : LILA;
          ctx.lineWidth = k * 3;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }

        // Cabeza: halo + estrella orientada al movimiento
        if (head && !finished) {
          const halo = ctx.createRadialGradient(
            head.x,
            head.y,
            0,
            head.x,
            head.y,
            26,
          );
          halo.addColorStop(0, LILA);
          halo.addColorStop(1, "transparent");
          ctx.globalAlpha = 0.3;
          ctx.fillStyle = halo;
          ctx.beginPath();
          ctx.arc(head.x, head.y, 26, 0, TAU);
          ctx.fill();
          drawSpark(ctx, head.x, head.y, 8, rot, 1);
        }

        // Partículas
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          const lt = (now - p.born) / p.life;
          if (lt >= 1) {
            particles.splice(i, 1);
            continue;
          }
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.04;
          p.vx *= 0.96;
          const a = (1 - lt) * (1 - lt);
          if (p.star) {
            drawSpark(ctx, p.x, p.y, p.size * (1 - lt * 0.5), 0, a, p.pale);
          } else {
            ctx.globalAlpha = a;
            ctx.fillStyle = p.pale ? PALE : LILA;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size * 0.4, 0, TAU);
            ctx.fill();
          }
        }

        if (!finished || particles.length || trail.length) {
          requestAnimationFrame(frame);
        } else {
          canvas.remove();
        }
      }
      requestAnimationFrame(frame);
    }

    const stage = document.querySelector<HTMLElement>(".summon-stage");
    if (!stage) return;
    const targets = stage.querySelectorAll("[data-summon]");
    if (!targets.length) return;

    if (reduced) return; // sin escenario armado, todo queda visible

    // La función no empieza hasta que el velo de carga se levanta
    const whenLoaded = (fn: () => void) => {
      if (
        !document.getElementById("site-loader") ||
        document.documentElement.classList.contains("is-loaded")
      ) {
        fn();
      } else {
        document.addEventListener("lunari:loaded", () => fn(), { once: true });
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          whenLoaded(() =>
            setTimeout(() => {
              runStage(stage);
              // Seguro: si algo falla, nada se queda invisible
              setTimeout(() => {
                targets.forEach((el) => el.classList.add("sm-lit"));
              }, 12000);
            }, 350),
          );
        });
      },
      { threshold: 0.12 },
    );

    // En pestañas ocultas rAF está pausado: arma y arranca solo al ser visible,
    // para que la función no se "queme" en segundo plano.
    const begin = () => {
      stage.classList.add("summon-ready");
      io.observe(stage);
    };
    if (document.visibilityState === "hidden") {
      const onVis = () => {
        if (document.visibilityState === "visible") {
          document.removeEventListener("visibilitychange", onVis);
          begin();
        }
      };
      document.addEventListener("visibilitychange", onVis);
    } else {
      begin();
    }
  })();
</script>
