---
/**
 * SocialBubble: redes de la Legion siempre visibles (Instagram, Ko-fi, Discord).
 * Fija en todas las páginas.
 */
const DISCORD_URL = 'https://discord.com/invite/j2mEbRg9jc';
const INSTAGRAM_URL = 'https://www.instagram.com/legionlunari/';
// TODO: reemplazar por la URL real de Ko-fi.
const KOFI_URL = '#';

const socials = [
  { name: 'Instagram', href: INSTAGRAM_URL, key: 'instagram' },
  { name: 'Ko-fi', href: KOFI_URL, key: 'kofi' },
  { name: 'Discord', href: DISCORD_URL, key: 'discord' },
];
---

<nav class="bubble" aria-label="Redes sociales">
  {socials.map((s) => (
    <a class={`bubble__link bubble__link--${s.key}`} href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
      {s.key === 'instagram' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      )}
      {s.key === 'kofi' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h12v5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V7Z" />
          <path d="M16 8h2.5a2.5 2.5 0 0 1 0 5H16" />
          <path d="M8 3v1.5M11 3v1.5" stroke-linecap="round" />
        </svg>
      )}
      {s.key === 'discord' && (
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.3 5.3A16.7 16.7 0 0 0 15.1 4l-.2.4a12.6 12.6 0 0 1 3.7 1.9 11.9 11.9 0 0 0-10.9 0A12.6 12.6 0 0 1 11.1 4.4L10.9 4A16.7 16.7 0 0 0 6.7 5.3C4.1 9.2 3.4 13 3.7 16.7A16.8 16.8 0 0 0 8.8 19l.6-1a10.9 10.9 0 0 1-1.7-.8l.4-.3a11.9 11.9 0 0 0 10 0l.4.3a10.9 10.9 0 0 1-1.7.8l.6 1a16.8 16.8 0 0 0 5.1-2.3c.4-4.3-.6-8.1-3.2-11.4ZM9.7 14.6c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm4.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z" />
        </svg>
      )}
    </a>
  ))}
</nav>

<style>
  .bubble {
    position: fixed;
    right: clamp(1rem, 2vw, 1.6rem);
    bottom: clamp(1rem, 2vw, 1.6rem);
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .bubble__link {
    display: grid;
    place-items: center;
    width: 50px; height: 50px;
    border-radius: 50%;
    color: var(--moonlight);
    background: color-mix(in srgb, var(--night-800) 78%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px) saturate(1.2);
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.9);
    transition: transform 0.25s var(--ease-out), border-color 0.25s var(--ease-out), color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }
  .bubble__link svg { width: 23px; height: 23px; }
  .bubble__link:hover {
    color: var(--celeste-400);
    border-color: var(--lavender-400);
    transform: translateY(-2px) scale(1.08);
    box-shadow: 0 0 40px -8px color-mix(in srgb, var(--lavender-400) 70%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble__link { transition: none; }
  }
</style>
