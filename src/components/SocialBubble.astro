                fill="currentColor"
                fill-rule="nonzero"
              />
            </g>
          </svg>
        )}
      </a>
    ))
  }
</nav>

<style>
  .bubble {
    position: fixed;
    right: clamp(1rem, 2vw, 1.6rem);
    bottom: clamp(1rem, 2vw, 1.6rem);
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .bubble__link {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    color: var(--moonlight);
    background: color-mix(in srgb, var(--night-800) 78%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px) saturate(1.2);
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.9);
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .bubble__link svg {
    width: 23px;
    height: 23px;
  }
  .bubble__link:hover {
    color: var(--celeste-400);
    border-color: var(--lavender-400);
    transform: translateY(-2px) scale(1.08);
    box-shadow: 0 0 40px -8px
      color-mix(in srgb, var(--lavender-400) 70%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble__link {
      transition: none;
    }
  }
</style>
