---
// AdminCard.astro — carta astral del staff: marco con acento propio, medallón
// superior, gema inferior, retrato que se funde en la noche y filas talismán.

export interface Props {
  /** Character/display name shown as the big title */
  name: string;
  /** Role label under the name (default: "ADMINISTRADORA") */
  role?: string;
  /** Path or URL to the background artwork */
  image: string;
  /** CSS object-position for the background image, e.g. "center 15%" */
  imagePosition?: string;
  /** LoL playstyle, e.g. "Agresivo" */
  playstyle: string;
  /** Region, e.g. "LAN" */
  region: string;
  /** Lane(s), e.g. "SUPP - JG" */
  lanes: string;
  /** Label for the last row — "INSTA" or "MBTI" work well */
  lastLabel?: string;
  /** Value for the last row — @handle or a type like "INFJ" */
  lastValue: string;
  /** Optional confession/quote line. Omit to hide the whole block */
  confession?: string;
  /** Accent color for frame/name/ornaments (per admin) */
  accent?: string;
  /** Manual overlay color (hex/rgb). Leave unset to auto-detect from the image */
  overlayColor?: string;
}

const {
  name,
  role = "ADMINISTRADORA",
  image,
  imagePosition = "center 15%",
  playstyle,
  region,
  lanes,
  lastLabel = "INSTA",
  lastValue,
  confession,
  accent = "#b9a3f0",
  overlayColor,
} = Astro.props;

const autoColor = !overlayColor;
const initialColor = overlayColor ?? accent;

const pills = [
  { label: "Estilo de juego", value: playstyle },
  { label: "Región", value: region },
  { label: "Línea", value: lanes },
  { label: lastLabel, value: lastValue },
];
---

<div
  class="admin-card"
  data-auto-color={autoColor ? "true" : "false"}
  style={`--accent:${accent}; --overlay-color:${initialColor};`}
>
  <span class="card__tick card__tick--tl" aria-hidden="true"></span>
  <span class="card__tick card__tick--tr" aria-hidden="true"></span>
  <span class="card__tick card__tick--bl" aria-hidden="true"></span>
  <span class="card__tick card__tick--br" aria-hidden="true"></span>

  <span class="card__spark card__spark--l" aria-hidden="true">✦</span>
  <span class="card__spark card__spark--r" aria-hidden="true">+</span>

  <div class="card__inner">
    <img
      class="card__bg"
      src={image}
      alt={name}
      style={`object-position:${imagePosition};`}
      crossorigin="anonymous"
      loading="lazy"
      decoding="async"
    />

    <div class="card__scrim" aria-hidden="true"></div>

    <div class="card__content">
      <div class="card__heading">
        <h1 class="card__name">{name}</h1>
        <p class="card__role">{role}</p>
      </div>

      <div class="card__pills">
        {
          pills.map((p) => (
            <div class="pill">
              <span class="pill__label">{p.label}</span>
              <svg
                class="pill__icon"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 0 L14.6 9.4 L24 12 L14.6 14.6 L12 24 L9.4 14.6 L0 12 L9.4 9.4 Z" />
              </svg>
              <span class="pill__value">{p.value}</span>
            </div>
          ))
        }
      </div>

      {
        confession && (
          <div class="card__confession">
            <h2>Confesión:</h2>
            <p>&ldquo;{confession}&rdquo;</p>
          </div>
        )
      }

      <div class="card__footer">
        <svg
          class="footer__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
          <circle cx="12" cy="12" r="4.6"></circle>
          <circle cx="17.6" cy="6.4" r="0.9" fill="currentColor" stroke="none"
          ></circle>
        </svg>
        <span>Legion Lunari</span>
      </div>
    </div>
  </div>

  <span class="card__gem" aria-hidden="true">✦</span>
</div>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Baloo+2:wght@400;500;600;700&display=swap");

  .admin-card {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 9 / 16;
    container-type: inline-size;
    container-name: admincard;
    font-family: "Baloo 2", system-ui, sans-serif;
    color: #fff;
    isolation: isolate;
  }

  /* Marco: borde de acento + línea interior fina; recorta el retrato */
  .card__inner {
    position: absolute;
    inset: 0;
    border-radius: 26px;
    overflow: hidden;
    background: #0d0d24;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.35),
      0 0 36px -12px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .card__inner::after {
    content: "";
    position: absolute;
    inset: 7px;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    pointer-events: none;
    z-index: 3;
  }

  /* Gema sobre el borde inferior, con puntitos satélite · ✦ · */
  .card__gem {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 50%);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--accent);
    font-size: 1.15rem;
    line-height: 1;
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 80%, transparent);
  }
  .card__gem::before,
  .card__gem::after {
    content: "";
    width: 3px;
    height: 3px;
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  /* Ticks de chaflán en las cuatro esquinas del marco */
  .card__tick {
    position: absolute;
    z-index: 4;
    width: 1.05rem;
    height: 1px;
    background: linear-gradient(to right,
      transparent,
      color-mix(in srgb, var(--accent) 75%, transparent) 50%,
      transparent);
  }
  .card__tick::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 3px;
    transform: translate(-50%, -50%) rotate(45deg);
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 80%, transparent);
  }
  .card__tick--tl { top: 0.95rem; left: 0.55rem; transform: rotate(-45deg); }
  .card__tick--tr { top: 0.95rem; right: 0.55rem; transform: rotate(45deg); }
  .card__tick--bl { bottom: 0.95rem; left: 0.55rem; transform: rotate(45deg); }
  .card__tick--br { bottom: 0.95rem; right: 0.55rem; transform: rotate(-45deg); }

  /* Destellos flotando junto al marco */
  .card__spark {
    position: absolute;
    z-index: 4;
    color: color-mix(in srgb, var(--accent) 85%, #fff);
    line-height: 1;
    text-shadow: 0 0 8px color-mix(in srgb, var(--accent) 75%, transparent);
    animation: cardSparkTwinkle 3.2s ease-in-out infinite;
  }
  .card__spark--l {
    left: -0.5rem;
    top: 21%;
    font-size: 0.8rem;
  }
  .card__spark--r {
    right: -0.45rem;
    top: 58%;
    font-size: 0.9rem;
    animation-delay: 1.5s;
  }
  @keyframes cardSparkTwinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.82); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__spark { animation: none; }
  }

  /* Retrato: ocupa la mitad superior y se funde hacia el cuerpo oscuro */
  .card__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60%;
    object-fit: cover;
    z-index: 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 98%);
  }

  /* Tinte del color del arte + caída a azul noche */
  .card__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(90% 45% at 50% 0%,
        color-mix(in srgb, var(--overlay-color) 28%, transparent) 0%,
        transparent 70%),
      linear-gradient(to bottom,
        transparent 34%,
        rgba(13, 13, 36, 0.5) 50%,
        #10102b 62%,
        #0d0d24 100%);
    transition: background 0.6s ease;
  }

  .card__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 0 7cqw 6cqw;
    box-sizing: border-box;
  }

  .card__heading {
    margin-top: auto;
    text-align: center;
    padding-bottom: 3.5cqw;
  }

  .card__name {
    margin: 0;
    font-family: "Cinzel Decorative", serif;
    font-weight: 700;
    font-size: clamp(1.9rem, 10cqw, 3.6rem);
    line-height: 1;
    letter-spacing: 0.04em;
    background: linear-gradient(180deg, #fdfaf4 25%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.6));
  }

  .card__role {
    margin: 0.7em 0 0;
    font-size: clamp(0.68rem, 2.7cqw, 1rem);
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    text-indent: 0.35em; /* nudge for the trailing letter-spacing */
    color: color-mix(in srgb, var(--accent) 55%, #f3ecec);
  }

  .card__pills {
    display: flex;
    flex-direction: column;
    gap: 2.4cqw;
    width: 100%;
  }

  /* Filas talismán: oscuras, contorneadas con el acento */
  .pill {
    display: flex;
    align-items: center;
    gap: 3cqw;
    width: 100%;
    background: rgba(10, 11, 30, 0.55);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    color: #eef0ff;
    border-radius: 999px;
    padding: 2.6cqw 5cqw;
    box-sizing: border-box;
    font-size: clamp(0.72rem, 3cqw, 1rem);
  }

  .pill__label {
    font-weight: 500;
    white-space: nowrap;
    min-width: 9em;
    color: color-mix(in srgb, #eef0ff 75%, var(--accent));
  }

  .pill__icon {
    flex: 0 0 auto;
    width: clamp(0.7rem, 3cqw, 1.1rem);
    height: clamp(0.7rem, 3cqw, 1.1rem);
    color: var(--accent);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent) 70%, transparent));
  }

  .pill__value {
    font-weight: 500;
    margin-left: auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__confession {
    text-align: center;
    margin-top: 4.5cqw;
  }

  .card__confession h2 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    margin: 0 0 0.45em;
    font-size: clamp(0.95rem, 4cqw, 1.5rem);
    font-weight: 700;
    color: color-mix(in srgb, var(--accent) 70%, #fff);
  }
  .card__confession h2::before,
  .card__confession h2::after {
    content: "";
    height: 1px;
    width: 2.2em;
    background: linear-gradient(to right,
      transparent, color-mix(in srgb, var(--accent) 55%, transparent));
  }
  .card__confession h2::after {
    background: linear-gradient(to left,
      transparent, color-mix(in srgb, var(--accent) 55%, transparent));
  }

  .card__confession p {
    margin: 0;
    font-size: clamp(0.75rem, 3cqw, 1.05rem);
    font-weight: 400;
    line-height: 1.4;
    color: #ded7f0;
  }

  .card__footer {
    margin-top: 4.5cqw;
    display: flex;
    align-items: center;
    gap: 2cqw;
    font-size: clamp(0.7rem, 2.6cqw, 0.95rem);
    font-weight: 600;
    color: #cfc8e6;
  }

  .footer__icon {
    width: clamp(0.9rem, 3.4cqw, 1.3rem);
    height: clamp(0.9rem, 3.4cqw, 1.3rem);
  }
</style>

<script>
  // Auto-detect a representative color from each card's background image
  // (favors saturated pixels so it lands close to the art's accent hue),
  // unless the caller passed an explicit `overlayColor` prop.
  function averageColor(
    img: CanvasImageSource,
  ): [number, number, number] | null {
    const size = 32;
    const canvas = document.createElement("canvas");
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext("2d");
    if (!ctx) return null;
    try {
      ctx.drawImage(img, 0, 0, size, size);
      const { data } = ctx.getImageData(0, 0, size, size);
      let r = 0,
        g = 0,
        b = 0,
        weight = 0;
      for (let i = 0; i < data.length; i += 4) {
        const [rr, gg, bb, aa] = [
          data[i],
          data[i + 1],
          data[i + 2],
          data[i + 3],
        ];
        if (aa < 200) continue;
        const max = Math.max(rr, gg, bb);
        const min = Math.min(rr, gg, bb);
        const sat = max === 0 ? 0 : (max - min) / max;
        const w = 0.2 + sat; // bias toward vivid pixels over grays
        r += rr * w;
        g += gg * w;
        b += bb * w;
        weight += w;
      }
      if (weight === 0) return null;
      return [
        Math.round(r / weight),
        Math.round(g / weight),
        Math.round(b / weight),
      ];
    } catch {
      return null; // tainted canvas (cross-origin image without CORS)
    }
  }

  function darken(
    [r, g, b]: [number, number, number],
    amount: number,
  ): [number, number, number] {
    return [r, g, b].map((v) => Math.round(v * (1 - amount))) as [
      number,
      number,
      number,
    ];
  }

  function applyAutoColor(card: HTMLElement) {
    const img = card.querySelector(".card__bg") as HTMLImageElement | null;
    if (!img) return;
    const run = async () => {
      // createImageBitmap con resize decodifica y reduce fuera del hilo
      // principal; sin él, cae al camino síncrono de siempre.
      let source: CanvasImageSource = img;
      try {
        if ("createImageBitmap" in window) {
          source = await createImageBitmap(img, {
            resizeWidth: 32,
            resizeHeight: 32,
          });
        }
      } catch {
        source = img;
      }
      const rgb = averageColor(source);
      if (!rgb) return;
      const [r, g, b] = darken(rgb, 0.25);
      card.style.setProperty("--overlay-color", `rgb(${r}, ${g}, ${b})`);
    };
    if (img.complete) run();
    else img.addEventListener("load", run, { once: true });
  }

  document
    .querySelectorAll<HTMLElement>('.admin-card[data-auto-color="true"]')
    .forEach(applyAutoColor);
</script>
